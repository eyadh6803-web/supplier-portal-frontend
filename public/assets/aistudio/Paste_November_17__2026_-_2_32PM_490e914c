/**
 * USABLE 3D EXPERIENCE A — SCREEN 04: 3D WORKFLOW & SUPPLY CHAIN STAGE TRACKER
 */
const WorkflowStageThreeScene = ({ theme, stages, currentStageIdx, selectedStageIdx, onSelectStage }) => {
  const mountRef = useRef(null);
  const selectedRef = useRef(selectedStageIdx);
  selectedRef.current = selectedStageIdx;

  useEffect(() => {
    const container = mountRef.current;
    if (!container) return;
    let animationFrameId;
    let renderer;

    try {
      const width = container.clientWidth || 720;
      const height = container.clientHeight || 220;
      const isDark = theme === 'dark';

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 60);
      camera.position.set(0, 2.3, 7.6);
      camera.lookAt(0, 0, 0);

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, isDark ? 1.15 : 1.75));
      const keyLight = new THREE.DirectionalLight(0xffffff, 1.4);
      keyLight.position.set(4, 7, 6);
      scene.add(keyLight);

      const group = new THREE.Group();
      scene.add(group);

      const spacing = 2.1;
      const startX = -((stages.length - 1) * spacing) / 2;
      const nodeMeshes = [];

      const trackGeo = new THREE.BoxGeometry((stages.length - 1) * spacing, 0.08, 0.16);
      const trackMat = new THREE.MeshStandardMaterial({
        color: isDark ? 0x262b38 : 0xcbd5e1,
        metalness: 0.6,
        roughness: 0.3
      });
      const track = new THREE.Mesh(trackGeo, trackMat);
      track.position.y = -0.05;
      group.add(track);

      const completedRatio = Math.max(0.02, currentStageIdx / Math.max(1, stages.length - 1));
      const progWidth = (stages.length - 1) * spacing * completedRatio;
      const progGeo = new THREE.BoxGeometry(progWidth, 0.1, 0.18);
      const progMat = new THREE.MeshStandardMaterial({
        color: 0x10b981,
        emissive: 0x10b981,
        emissiveIntensity: 0.45
      });
      const progBeam = new THREE.Mesh(progGeo, progMat);
      progBeam.position.set(startX + progWidth / 2, -0.04, 0.01);
      group.add(progBeam);

      stages.forEach((st, idx) => {
        const isCurrent = idx === currentStageIdx;
        const isCompleted = idx <= currentStageIdx;
        const isRejected = st === 'Rejected' && isCurrent;

        const baseColor = isRejected
          ? 0xe32236
          : isCurrent
          ? 0xe32236
          : isCompleted
          ? 0x10b981
          : isDark
          ? 0x2a303f
          : 0x94a3b8;

        const mat = new THREE.MeshStandardMaterial({
          color: baseColor,
          emissive: isCurrent || isCompleted ? baseColor : 0x000000,
          emissiveIntensity: isCurrent ? 0.55 : isCompleted ? 0.25 : 0,
          metalness: 0.45,
          roughness: 0.25
        });

        const pedestal = new THREE.Mesh(new THREE.CylinderGeometry(0.46, 0.54, 0.28, 32), mat);
        pedestal.position.set(startX + idx * spacing, 0, 0);
        pedestal.userData = { stageIndex: idx };
        group.add(pedestal);
        nodeMeshes.push(pedestal);

        const core = new THREE.Mesh(
          isCurrent ? new THREE.OctahedronGeometry(0.24, 0) : new THREE.CylinderGeometry(0.18, 0.18, 0.18, 24),
          mat
        );
        core.position.set(startX + idx * spacing, 0.42, 0);
        core.userData = { stageIndex: idx };
        group.add(core);
        nodeMeshes.push(core);
      });

      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();

      const handleClick = (e) => {
        const rect = container.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(nodeMeshes, false);
        if (hits.length > 0 && typeof hits[0].object.userData.stageIndex === 'number') {
          onSelectStage(hits[0].object.userData.stageIndex);
        }
      };
      container.addEventListener('click', handleClick);

      const handleResize = () => {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      };
      window.addEventListener('resize', handleResize);

      const clock = new THREE.Clock();
      const animate = () => {
        animationFrameId = requestAnimationFrame(animate);
        const t = clock.getElapsedTime();

        const targetX = (startX + selectedRef.current * spacing) * 0.45;
        camera.position.x += (targetX - camera.position.x) * 0.08;
        camera.lookAt(targetX * 0.6, 0.1, 0);

        nodeMeshes.forEach((m) => {
          if (m.geometry.type === 'OctahedronGeometry') {
            m.rotation.y = t * 1.4;
            m.position.y = 0.44 + Math.sin(t * 2.5) * 0.05;
          }
        });

        renderer.render(scene, camera);
      };
      animate();

      return () => {
        cancelAnimationFrame(animationFrameId);
        container.removeEventListener('click', handleClick);
        window.removeEventListener('resize', handleResize);
        if (renderer?.domElement && container.contains(renderer.domElement)) {
          container.removeChild(renderer.domElement);
        }
        renderer.dispose();
      };
    } catch (e) {
      console.warn(e);
    }
  }, [theme, stages, currentStageIdx, onSelectStage]);

  return <div ref={mountRef} className="w-full h-[220px] cursor-pointer" />;
};

