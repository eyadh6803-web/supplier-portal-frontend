// 2.5 BACKEND-READY API SERVICE LAYER (SET USE_LIVE_API = true WHEN BACKEND IS LIVE)
// ============================================================================
const resolveApiBaseUrl = () => {
  try {
    if (typeof window !== 'undefined' && window.__PROCURA_API_URL__) {
      return window.__PROCURA_API_URL__;
    }
    if (typeof process !== 'undefined' && process.env && process.env.VITE_API_BASE_URL) {
      return process.env.VITE_API_BASE_URL;
    }
  } catch {
    // Ignore environment access issues in sandboxed browsers
  }
  return 'https://api.procura.io/v1';
};

const API_CONFIG = {
  USE_LIVE_API: false, // Switch to true in Antigravity once your backend endpoints are ready
  BASE_URL: resolveApiBaseUrl()
};

const apiRequest = async (endpoint, options = {}) => {
  const token = localStorage.getItem('procura_jwt_token');
  const isFormData = options.body instanceof FormData;
  const headers = {
    ...(isFormData ? {} : { 'Content-Type': 'application/json' }),
    ...(token ? { Authorization: `Bearer ${token}` } : {}),
    ...(options.headers || {})
  };

  const response = await fetch(`${API_CONFIG.BASE_URL}${endpoint}`, {
    ...options,
    headers
  });

  if (!response.ok) {
    const errPayload = await response.json().catch(() => ({}));
    throw new Error(errPayload.message || `API Error (${response.status})`);
  }
  return response.status === 204 ? null : response.json();
};

const ProcuraApiService = {
  // POST /auth/login
  async login(email, password) {
    if (!API_CONFIG.USE_LIVE_API) {
      const matched = DEMO_USERS.find((u) => u.email.toLowerCase() === email.trim().toLowerCase());
      return { user: matched || null, token: 'demo-jwt-token' };
    }
    const data = await apiRequest('/auth/login', {
      method: 'POST',
      body: JSON.stringify({ email, password })
    });
    if (data?.token) localStorage.setItem('procura_jwt_token', data.token);
    return data;
  },

  // GET /requests
  async fetchRequests() {
    if (!API_CONFIG.USE_LIVE_API) return null; // Uses local state baseline in demo mode
    return apiRequest('/requests');
  },

  // POST /requests
  async createRequest(payload) {
    if (!API_CONFIG.USE_LIVE_API) return payload;
    return apiRequest('/requests', {
      method: 'POST',
      body: JSON.stringify(payload)
    });
  },

  // PATCH /requests/:id/status
  async updateRequestStatus(requestId, status, reason = '') {
    if (!API_CONFIG.USE_LIVE_API) return { id: requestId, status, reason };
    return apiRequest(`/requests/${requestId}/status`, {
      method: 'PATCH',
      body: JSON.stringify({ status, reason })
    });
  },

  // POST /requests/:id/invite
  async inviteSuppliers(requestId, supplierIds) {
    if (!API_CONFIG.USE_LIVE_API) return { requestId, supplierIds };
    return apiRequest(`/requests/${requestId}/invite`, {
      method: 'POST',
      body: JSON.stringify({ supplierIds })
    });
  },

  // POST /quotations/upload (Multipart FormData for real PDF upload)
  async uploadQuotationPdf(requestId, supplierId, file) {
    if (!API_CONFIG.USE_LIVE_API) return null;
    const formData = new FormData();
    formData.append('requestId', requestId);
    formData.append('supplierId', supplierId);
    formData.append('file', file);
