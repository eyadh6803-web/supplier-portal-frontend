        window.removeEventListener('resize', handleResize);
        if (renderer?.domElement && container.contains(renderer.domElement)) {
          container.removeChild(renderer.domElement);
        }
        renderer.dispose();
      };
    } catch (e) {
      console.warn(e);
    }
  }, [theme, extractionStatus, hasMissingField]);

  return <div ref={mountRef} className="w-full h-[320px]" />;
};

/**
 * USABLE 3D EXPERIENCE C — SCREEN 11: INTERACTIVE 3D SUPPLIER DECISION MATRIX
 */
const ComparisonThreeScene = ({ theme, offers, priority, selectedOfferId, onSelectOffer }) => {
  const mountRef = useRef(null);
  const selectedRef = useRef(selectedOfferId);
  selectedRef.current = selectedOfferId;

  useEffect(() => {
    const container = mountRef.current;
    if (!container || !offers.length) return;
    let animationFrameId;
    let renderer;

    try {
      const width = container.clientWidth || 640;
      const height = container.clientHeight || 220;
      const isDark = theme === 'dark';

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 60);
      camera.position.set(0, 2.2, 6.8);
      camera.lookAt(0, 0.4, 0);

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, isDark ? 1.2 : 1.75));
      const dirLight = new THREE.DirectionalLight(0xffffff, 1.4);
      dirLight.position.set(4, 7, 5);
      scene.add(dirLight);

      const group = new THREE.Group();
      scene.add(group);

      const prices = offers.map((o) => o.totalPrice || 1);
      const minPrice = Math.min(...prices);
      const maxPrice = Math.max(...prices);

      const days = offers.map((o) => o.deliveryDays || 1);
      const minDays = Math.min(...days);
      const maxDays = Math.max(...days);

      const warranties = offers.map((o) => o.warrantyMonths || 12);
      const maxWarranty = Math.max(...warranties);

      const scores = offers.map((o) => {
        const priceScore = maxPrice === minPrice ? 1 : 1 - (o.totalPrice - minPrice) / (maxPrice - minPrice + 1);
        const speedScore = maxDays === minDays ? 1 : 1 - (o.deliveryDays - minDays) / (maxDays - minDays + 1);
        const warrantyScore = (o.warrantyMonths || 12) / (maxWarranty || 36);
        if (priority === 'price') return 0.35 + priceScore * 0.65;
        if (priority === 'delivery') return 0.35 + speedScore * 0.65;
        if (priority === 'warranty') return 0.35 + warrantyScore * 0.65;
        return 0.35 + (priceScore * 0.45 + speedScore * 0.35 + warrantyScore * 0.2) * 0.65;
      });
      const topScore = Math.max(...scores);

      const spacing = 2.0;
      const startX = -((offers.length - 1) * spacing) / 2;
      const barMeshes = [];

      offers.forEach((offer, idx) => {
        const isBest = Math.abs(scores[idx] - topScore) < 0.001;
        const barHeight = 0.5 + scores[idx] * 1.65;

        const mat = new THREE.MeshStandardMaterial({
          color: isBest ? 0x10b981 : isDark ? 0x3b4254 : 0x94a3b8,
          emissive: isBest ? 0x10b981 : 0x000000,
          emissiveIntensity: isBest ? 0.35 : 0,
          roughness: 0.25,
          metalness: 0.45
        });

        const bar = new THREE.Mesh(new THREE.BoxGeometry(0.85, barHeight, 0.85), mat);
        bar.position.set(startX + idx * spacing, barHeight / 2 - 0.5, 0);
        bar.userData = { offerId: offer.id, isBest };
        group.add(bar);
        barMeshes.push(bar);
      });

      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      const handleClick = (e) => {
        const rect = container.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(barMeshes, false);
        if (hits.length > 0 && hits[0].object.userData.offerId) {
          onSelectOffer(hits[0].object.userData.offerId);
        }
      };
      container.addEventListener('click', handleClick);

      const handleResize = () => {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      };
      window.addEventListener('resize', handleResize);

      const animate = () => {
        animationFrameId = requestAnimationFrame(animate);
        barMeshes.forEach((b) => {
          const isSelected = b.userData.offerId === selectedRef.current;
          const col = isSelected ? 0xe32236 : b.userData.isBest ? 0x10b981 : isDark ? 0x3b4254 : 0x94a3b8;
          b.material.color.setHex(col);
          b.material.emissive.setHex(isSelected ? 0xe32236 : b.userData.isBest ? 0x10b981 : 0x000000);
          b.material.emissiveIntensity = isSelected ? 0.55 : b.userData.isBest ? 0.35 : 0;
        });
        renderer.render(scene, camera);
      };
      animate();

      return () => {
        cancelAnimationFrame(animationFrameId);
        container.removeEventListener('click', handleClick);
        window.removeEventListener('resize', handleResize);
        if (renderer?.domElement && container.contains(renderer.domElement)) {
          container.removeChild(renderer.domElement);
        }
        renderer.dispose();
      };
    } catch (e) {
      console.warn(e);
    }
  }, [theme, offers, priority, onSelectOffer]);

  return <div ref={mountRef} className="w-full h-[220px] cursor-pointer" />;
};

/**
 * USABLE 3D EXPERIENCE 01 — SCREEN 01: INTERACTIVE 3D ROLE CREDENTIAL PAPERS
 * Floating 3D credential sheets representing each login role. Clicking any paper
 * smoothly zooms in with a crimson calibration frame & scanline effect, and typing
 * updates both the 3D paper texture and the main Sign In widget in real time.
 */
const LoginRolePapersThreeScene = ({
  theme,
  lang,
  users,
  selectedRole,
  onSelectRole,
  liveEmail,
  livePassword,
  showPwd
}) => {
  const mountRef = useRef(null);
  const selectedRoleRef = useRef(selectedRole);
  selectedRoleRef.current = selectedRole;

  const texturesRef = useRef({});
  const canvasesRef = useRef({});

  // Helper to trace a rounded rectangle path on 2D canvas
  const roundRectPath = (ctx, x, y, w, h, r) => {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  };

  // Render an executive brushed-titanium & carbon security credential card texture
  const drawPaperTexture = useCallback((canvas, user, isSelected, emailVal, pwdVal, revealPwd, currentTheme, currentLang) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const isDark = currentTheme === 'dark';
    const isAr = currentLang === 'ar';
    const w = canvas.width;
    const h = canvas.height;

    ctx.clearRect(0, 0, w, h);

    // Rounded executive card silhouette
    roundRectPath(ctx, 4, 4, w - 8, h - 8, 28);
    ctx.save();
    ctx.clip();

    // Rich multi-stop brushed anodized surface
    const baseGrad = ctx.createLinearGradient(0, 0, w, h);
    if (isDark) {
      baseGrad.addColorStop(0, '#222736');
      baseGrad.addColorStop(0.45, '#141822');
      baseGrad.addColorStop(1, '#0B0D13');
    } else {
      baseGrad.addColorStop(0, '#FFFFFF');
      baseGrad.addColorStop(0.5, '#F4F6FA');
      baseGrad.addColorStop(1, '#E6EAF2');
    }
    ctx.fillStyle = baseGrad;
    ctx.fillRect(0, 0, w, h);

    // Diagonal studio light reflection sweep across top-right
    const sheenGrad = ctx.createLinearGradient(0, 0, w * 0.85, h * 0.65);
    sheenGrad.addColorStop(0, isSelected ? 'rgba(227, 34, 54, 0.16)' : (isDark ? 'rgba(255,255,255,0.06)' : 'rgba(255,255,255,0.85)'));
    sheenGrad.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = sheenGrad;
    ctx.fillRect(0, 0, w, h);

    // Subtle micro-dot security guilloche pattern
    ctx.fillStyle = isDark ? 'rgba(255,255,255,0.04)' : 'rgba(15,23,42,0.045)';
    for (let dx = 28; dx < w - 20; dx += 18) {
      for (let dy = 28; dy < h - 20; dy += 18) {
        ctx.beginPath();
        ctx.arc(dx, dy, 1, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // Top crimson executive header bar
    const headerGrad = ctx.createLinearGradient(0, 0, w, 0);
    headerGrad.addColorStop(0, '#E32236');
    headerGrad.addColorStop(0.65, '#9E1422');
    headerGrad.addColorStop(1, isDark ? '#191C24' : '#252932');
    ctx.fillStyle = headerGrad;
    ctx.fillRect(0, 0, w, 62);

    // PROCURA geometric emblem inside header
    ctx.fillStyle = '#FFFFFF';
    ctx.font = '800 17px "Inter", sans-serif';
    ctx.fillText('PROCURA', 32, 38);

    ctx.fillStyle = 'rgba(255,255,255,0.75)';
    ctx.font = '600 11px "JetBrains Mono", monospace';
    const clearanceMap = {
      requester: 'CLEARANCE // LVL-01',
      officer: 'CLEARANCE // LVL-03',
      manager: 'EXECUTIVE // LVL-04',
      supplier: 'VENDOR // EXT-02'
    };
    ctx.fillText(clearanceMap[user.role] || 'LVL-01', w - 185, 37);

    // Clean Crimson Vertical Accent Bar + Role Title & Identity (No Credit-Card Chip)
    ctx.fillStyle = '#E32236';
    roundRectPath(ctx, 34, 82, 6, 74, 3);
    ctx.fill();

    const roleLabels = {
      en: {
        requester: 'REQUESTER',
        officer: 'PROCUREMENT OFFICER',
        manager: 'APPROVER / MANAGER',
        supplier: 'SUPPLIER PORTAL'
      },
      ar: {
        requester: 'مقدّم الطلب',
        officer: 'مسؤول المشتريات',
        manager: 'المدير المعتمد',
        supplier: 'بوابة المورد'
      }
    };
    ctx.fillStyle = isDark ? '#F8FAFC' : '#0F172A';
    ctx.font = '800 25px "Inter", "IBM Plex Sans Arabic", sans-serif';
    ctx.fillText(roleLabels[currentLang][user.role] || user.role.toUpperCase(), 54, 106);

    ctx.fillStyle = isDark ? '#CBD5E1' : '#334155';
    ctx.font = '600 15px "Inter", "IBM Plex Sans Arabic", sans-serif';
    const personLabel = isAr ? (user.companyNameAr || user.nameAr) : (user.companyName || user.name);
    ctx.fillText(personLabel, 54, 131);

    // Department Tag
    ctx.fillStyle = '#E32236';
    ctx.font = '700 11px "JetBrains Mono", monospace';
    const deptLabel = isAr ? (user.departmentAr || 'شبكة الموردين') : (user.department || 'External Vendor Network');
    ctx.fillText(deptLabel.toUpperCase(), 54, 153);

    // Rounded Live-Editable Email Pill
    roundRectPath(ctx, 32, 176, w - 64, 74, 14);
    ctx.fillStyle = isDark ? 'rgba(9, 11, 16, 0.85)' : 'rgba(255, 255, 255, 0.92)';
    ctx.fill();
    ctx.strokeStyle = isSelected ? '#E32236' : (isDark ? 'rgba(255,255,255,0.12)' : 'rgba(15,23,42,0.12)');
    ctx.lineWidth = isSelected ? 2.2 : 1.2;
    ctx.stroke();

    ctx.fillStyle = '#E32236';
    ctx.font = '700 10px "JetBrains Mono", monospace';
    ctx.fillText(isAr ? 'IDENTITY // البريد الإلكتروني' : 'ENTERPRISE IDENTITY', 48, 198);

    const displayEmail = isSelected ? (emailVal || 'type email...') : user.email;
    ctx.fillStyle = isDark ? '#F2F3F5' : '#0F172A';
    ctx.font = '600 17px "JetBrains Mono", monospace';
    ctx.fillText(displayEmail.slice(0, 32) + (isSelected ? '|' : ''), 48, 229);

    // Rounded Live-Editable Password Pill
    roundRectPath(ctx, 32, 266, w - 64, 74, 14);
    ctx.fillStyle = isDark ? 'rgba(9, 11, 16, 0.85)' : 'rgba(255, 255, 255, 0.92)';
    ctx.fill();
    ctx.strokeStyle = isSelected ? '#E32236' : (isDark ? 'rgba(255,255,255,0.12)' : 'rgba(15,23,42,0.12)');
    ctx.lineWidth = isSelected ? 2.2 : 1.2;
    ctx.stroke();

    ctx.fillStyle = '#E32236';
    ctx.font = '700 10px "JetBrains Mono", monospace';
    ctx.fillText(isAr ? 'PASSKEY // كلمة المرور' : 'ACCESS PASSKEY', 48, 288);

    const rawPwd = isSelected ? (pwdVal || '') : '••••••••••••';
    const hasPwd = rawPwd.length > 0;
    const maskedPwd = hasPwd
      ? (revealPwd ? rawPwd : '•'.repeat(rawPwd.length))
      : (isAr ? 'أدخل كلمة المرور...' : 'type password...');
    ctx.fillStyle = hasPwd
      ? (isDark ? '#F2F3F5' : '#0F172A')
      : (isDark ? '#64748B' : '#94A3B8');
    ctx.font = '600 17px "JetBrains Mono", monospace';
    ctx.fillText(maskedPwd.slice(0, 28), 48, 319);

    // Bottom Status Footer Bar
    roundRectPath(ctx, 32, 362, w - 64, 52, 12);
    ctx.fillStyle = isSelected ? 'rgba(227, 34, 54, 0.16)' : (isDark ? 'rgba(255,255,255,0.04)' : 'rgba(15,23,42,0.05)');
    ctx.fill();
    ctx.fillStyle = isSelected ? '#E32236' : (isDark ? '#94A3B8' : '#475569');
    ctx.font = '700 12px "JetBrains Mono", monospace';
    const statusFooter = isSelected
      ? (isAr ? '● البطاقة نشطة — اكتب مباشرة أو من اللوحة الجانبية' : '● PASS ACTIVE — SYNCED WITH SIGN-IN DRAWER')
      : (isAr ? 'اضغط لاختيار البطاقة وفتح لوحة الدخول' : 'CLICK CARD TO DEPLOY SIGN-IN PANEL →');
    ctx.fillText(statusFooter, 48, 393);

    ctx.restore();

    // Outer precision metallic bezel stroke
    roundRectPath(ctx, 4, 4, w - 8, h - 8, 28);
    ctx.strokeStyle = isSelected ? '#E32236' : (isDark ? 'rgba(255,255,255,0.18)' : 'rgba(15,23,42,0.16)');
    ctx.lineWidth = isSelected ? 4 : 2;
    ctx.stroke();
  }, []);

  // Re-paint textures live whenever typed email, password, theme, language, or selectedRole changes
  useEffect(() => {
    users.forEach((u) => {
      const canvas = canvasesRef.current[u.role];
      const tex = texturesRef.current[u.role];
      if (canvas && tex) {
        drawPaperTexture(
          canvas,
          u,
          selectedRole === u.role,
          liveEmail,
          livePassword,
          showPwd,
          theme,
          lang
        );
        tex.needsUpdate = true;
      }
    });
  }, [users, selectedRole, liveEmail, livePassword, showPwd, theme, lang, drawPaperTexture]);

  useEffect(() => {
    const container = mountRef.current;
    if (!container) return;
    let animationFrameId;
    let renderer;

    try {
      const width = container.clientWidth || 640;
      const height = container.clientHeight || 430;
      const isDark = theme === 'dark';

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 60);
      camera.position.set(0, 0.15, 7.2);

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      // Studio rim + key lighting for metallic card sheen
      scene.add(new THREE.AmbientLight(0xffffff, isDark ? 1.4 : 1.75));
      const keyLight = new THREE.DirectionalLight(0xffffff, 1.3);
      keyLight.position.set(3, 5, 7);
      scene.add(keyLight);

      const rimLight = new THREE.DirectionalLight(0xe32236, 0.55);
      rimLight.position.set(-4, -2, 4);
      scene.add(rimLight);

      const group = new THREE.Group();
      scene.add(group);

      // Clean architectural floor grid plane
      const gridHelper = new THREE.GridHelper(
        14,
        18,
        isDark ? 0x2a2f3d : 0xd1d5db,
        isDark ? 0x171b24 : 0xe5e7eb
      );
      gridHelper.position.y = -2.05;
      scene.add(gridHelper);

      const clickableMeshes = [];
      const paperNodes = [];

      // Balanced 2x2 spatial grid when unselected
      const baseSlots = [
        { x: -1.65, y: 0.72, z: 0.1, rotY: 0.14, rotZ: 0.025 },
        { x: 1.65, y: 0.72, z: -0.1, rotY: -0.14, rotZ: -0.025 },
        { x: -1.55, y: -0.78, z: -0.05, rotY: 0.12, rotZ: -0.02 },
        { x: 1.55, y: -0.78, z: 0.05, rotY: -0.12, rotZ: 0.02 }
      ];

      users.forEach((user, idx) => {
        const canvas = document.createElement('canvas');
        canvas.width = 560;
        canvas.height = 460;
        canvasesRef.current[user.role] = canvas;

        drawPaperTexture(
          canvas,
          user,
          selectedRoleRef.current === user.role,
          liveEmail,
          livePassword,
          showPwd,
          theme,
          lang
        );

        const texture = new THREE.CanvasTexture(canvas);
        texture.anisotropy = 4;
        texturesRef.current[user.role] = texture;

        // PlaneGeometry with alpha transparency so rounded corners render cleanly without boxy corners
        const cardGeo = new THREE.PlaneGeometry(2.38, 1.95);
        const faceMat = new THREE.MeshStandardMaterial({
          map: texture,
          transparent: true,
          roughness: 0.28,
          metalness: 0.18
        });

        const paperMesh = new THREE.Mesh(cardGeo, faceMat);
        const slot = baseSlots[idx % baseSlots.length];
        paperMesh.position.set(slot.x, slot.y, slot.z);
        paperMesh.rotation.set(0, slot.rotY, slot.rotZ);
        paperMesh.userData = { role: user.role };
        group.add(paperMesh);
        clickableMeshes.push(paperMesh);

        // Ambient holographic crimson back-halo & corner targeting reticles
        const haloMat = new THREE.MeshBasicMaterial({
          color: 0xe32236,
          transparent: true,
          opacity: 0
        });
        const haloMesh = new THREE.Mesh(new THREE.PlaneGeometry(2.58, 2.15), haloMat);
        haloMesh.position.z = -0.04;
        paperMesh.add(haloMesh);

        const reticleGroup = new THREE.Group();
        const reticleMat = new THREE.MeshBasicMaterial({
          color: 0xe32236,
          transparent: true,
          opacity: 0
        });
        const bracketConfigs = [
          { x: -1.24, y: 1.02, w: 0.24, h: 0.028, ox: 0.106, oy: -0.106 },
          { x: 1.24, y: 1.02, w: 0.24, h: 0.028, ox: -0.106, oy: -0.106 },
          { x: -1.24, y: -1.02, w: 0.24, h: 0.028, ox: 0.106, oy: 0.106 },
          { x: 1.24, y: -1.02, w: 0.24, h: 0.028, ox: -0.106, oy: 0.106 }
        ];
        bracketConfigs.forEach((b) => {
          const hBar = new THREE.Mesh(new THREE.PlaneGeometry(b.w, b.h), reticleMat);
          hBar.position.set(b.x + b.ox, b.y, 0.03);
          const vBar = new THREE.Mesh(new THREE.PlaneGeometry(b.h, b.w), reticleMat);
          vBar.position.set(b.x, b.y + b.oy, 0.03);
          reticleGroup.add(hBar, vBar);
        });
        paperMesh.add(reticleGroup);

        paperNodes.push({
          role: user.role,
          mesh: paperMesh,
          slot,
          haloMesh,
          haloMat,
          reticleGroup,
          reticleMat
        });
      });

      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      let hoveredRole = null;

      const handlePointerMove = (e) => {
        const rect = container.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(clickableMeshes, false);
        hoveredRole = hits.length > 0 ? hits[0].object.userData.role : null;
        container.style.cursor = hoveredRole ? 'pointer' : 'default';
      };

      const handleClick = (e) => {
        const rect = container.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(clickableMeshes, false);
        if (hits.length > 0 && hits[0].object.userData.role) {
          onSelectRole(hits[0].object.userData.role);
        }
      };

      container.addEventListener('pointermove', handlePointerMove);
      container.addEventListener('click', handleClick);

      const handleResize = () => {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      };
      window.addEventListener('resize', handleResize);

      const clock = new THREE.Clock();
      const animate = () => {
        animationFrameId = requestAnimationFrame(animate);
        const t = clock.getElapsedTime();
        const activeRole = selectedRoleRef.current;
        const isAr = lang === 'ar';

        let unselectedIdx = 0;

        paperNodes.forEach((node, idx) => {
          const isSelected = activeRole === node.role;
          const isHovered = hoveredRole === node.role;

          let targetX, targetY, targetZ, targetRotY, targetRotZ, targetScale;

          if (!activeRole) {
            // Initial state: commanding 2x2 grid shifted toward the left-center stage
            targetX = node.slot.x * 1.12 - (isAr ? -0.35 : 0.35);
            targetY = node.slot.y * 1.08 + Math.sin(t * 1.2 + idx * 1.3) * 0.05;
            targetZ = isHovered ? node.slot.z + 0.45 : node.slot.z + 0.25;
            targetRotY = node.slot.rotY;
            targetRotZ = node.slot.rotZ;
            targetScale = isHovered ? 1.18 : 1.1;
          } else if (isSelected) {
            // Active state: zoomed card positioned on the left-center stage beside the drawer
            targetX = isAr ? 0.55 : -0.55;
            targetY = 0.08;
            targetZ = 2.95;
            targetRotY = isAr ? -0.05 : 0.05;
            targetRotZ = 0;
            targetScale = 1.28;
          } else {
            // Remaining unselected cards stay visible, stacked cleanly along the side column
            const stackY = 1.15 - unselectedIdx * 1.15;
            targetX = isAr ? 2.65 : -2.65;
            targetY = stackY;
            targetZ = isHovered ? 0.35 : -0.15;
            targetRotY = isAr ? -0.16 : 0.16;
            targetRotZ = 0;
            targetScale = isHovered ? 0.68 : 0.6;
            unselectedIdx++;
          }

          node.mesh.position.x += (targetX - node.mesh.position.x) * 0.11;
          node.mesh.position.y += (targetY - node.mesh.position.y) * 0.11;
          node.mesh.position.z += (targetZ - node.mesh.position.z) * 0.11;

          node.mesh.rotation.y += (targetRotY - node.mesh.rotation.y) * 0.11;
          node.mesh.rotation.z += (targetRotZ - node.mesh.rotation.z) * 0.11;

          const nextScale = node.mesh.scale.x + (targetScale - node.mesh.scale.x) * 0.11;
          node.mesh.scale.set(nextScale, nextScale, nextScale);

          // Pulsing holographic back-halo + expanding corner targeting reticles
          const pulse = 0.5 + 0.5 * Math.sin(t * 3.0);
          const targetHaloOpacity = isSelected ? 0.16 + pulse * 0.1 : isHovered ? 0.08 : 0;
          node.haloMat.opacity += (targetHaloOpacity - node.haloMat.opacity) * 0.12;

          const targetReticleOpacity = isSelected ? 0.9 : isHovered ? 0.45 : 0;
          node.reticleMat.opacity += (targetReticleOpacity - node.reticleMat.opacity) * 0.14;
          const reticleExpand = isSelected ? 1.0 + pulse * 0.022 : 1.04;
          node.reticleGroup.scale.set(reticleExpand, reticleExpand, 1);
        });

        renderer.render(scene, camera);
      };
      animate();

      return () => {
        cancelAnimationFrame(animationFrameId);
        container.removeEventListener('pointermove', handlePointerMove);
        container.removeEventListener('click', handleClick);
        window.removeEventListener('resize', handleResize);
        Object.values(texturesRef.current).forEach((tx) => tx.dispose());
        if (renderer?.domElement && container.contains(renderer.domElement)) {
          container.removeChild(renderer.domElement);
        }
        renderer.dispose();
      };
    } catch (e) {
      console.warn(e);
    }
  }, [theme, lang, users, onSelectRole, drawPaperTexture]);

  return <div ref={mountRef} className="w-full h-[440px] sm:h-[510px]" />;
};

