// ============================================================================
// 6. MAIN APPLICATION (ALL 11 SCREENS + 44 CONFIGURATIONS)
// ============================================================================
export default function App() {
  const loadStored = (key, fallback) => {
    try {
      const item = localStorage.getItem(key);
      return item ? JSON.parse(item) : fallback;
    } catch {
      return fallback;
    }
  };

  const [theme, setTheme] = useState(() => loadStored('procura_theme', 'dark'));
  const [lang, setLang] = useState(() => loadStored('procura_lang', 'en'));
  const [currentUser, setCurrentUser] = useState(() => loadStored('procura_user', null));
  const [activeScreen, setActiveScreen] = useState(() => loadStored('procura_screen', 1));
  const [selectedRequestId, setSelectedRequestId] = useState(() => loadStored('procura_req_id', 'PR-1048'));
  const [selectedOfferId, setSelectedOfferId] = useState(() => loadStored('procura_offer_id', 'OFF-204'));
  const [requests, setRequests] = useState(() => loadStored('procura_requests', INITIAL_REQUESTS));
  const [offers, setOffers] = useState(() => loadStored('procura_offers', INITIAL_OFFERS));
  const [auditLog, setAuditLog] = useState(() => loadStored('procura_audit', INITIAL_AUDIT_LOG));
  const [isInviteModalOpen, setIsInviteModalOpen] = useState(false);
  const [presentationMode, setPresentationMode] = useState(false);
  const [toast, setToast] = useState(null);

  useEffect(() => { localStorage.setItem('procura_theme', JSON.stringify(theme)); }, [theme]);
  useEffect(() => { localStorage.setItem('procura_lang', JSON.stringify(lang)); }, [lang]);
  useEffect(() => { localStorage.setItem('procura_user', JSON.stringify(currentUser)); }, [currentUser]);
  useEffect(() => { localStorage.setItem('procura_screen', JSON.stringify(activeScreen)); }, [activeScreen]);
  useEffect(() => { localStorage.setItem('procura_req_id', JSON.stringify(selectedRequestId)); }, [selectedRequestId]);
  useEffect(() => { localStorage.setItem('procura_offer_id', JSON.stringify(selectedOfferId)); }, [selectedOfferId]);
  useEffect(() => { localStorage.setItem('procura_requests', JSON.stringify(requests)); }, [requests]);
  useEffect(() => { localStorage.setItem('procura_offers', JSON.stringify(offers)); }, [offers]);
  useEffect(() => { localStorage.setItem('procura_audit', JSON.stringify(auditLog)); }, [auditLog]);

  useEffect(() => {
    document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
    document.documentElement.lang = lang;
  }, [lang]);

  // Hydrate live backend data automatically when API_CONFIG.USE_LIVE_API is enabled
  useEffect(() => {
    if (!API_CONFIG.USE_LIVE_API) return;
    Promise.all([
      ProcuraApiService.fetchRequests(),
      ProcuraApiService.fetchAuditLogs()
    ])
      .then(([liveReqs, liveLogs]) => {
        if (Array.isArray(liveReqs)) setRequests(liveReqs);
        if (Array.isArray(liveLogs)) setAuditLog(liveLogs);
      })
      .catch((err) => console.error('Failed to sync with PROCURA API:', err));
  }, []);

  const t = TRANSLATIONS[lang];
  const isDark = theme === 'dark';
  const isRtl = lang === 'ar';

  const showToast = useCallback((msg, type = 'success') => {
    setToast({ msg, type });
    setTimeout(() => setToast(null), 3500);
  }, []);

  const addAuditEntry = useCallback((action, actionAr, requestId, details, detailsAr) => {
    const actor = currentUser ? currentUser.name : 'System';
    const actorAr = currentUser ? currentUser.nameAr : 'النظام';
    const now = new Date().toISOString().replace('T', ' ').substring(0, 19);
    const entry = {
      id: `AUD-${Math.floor(1000 + Math.random() * 9000)}`,
      timestamp: now,
      user: actor,
      userAr: actorAr,
      action,
      actionAr,
      requestId,
      details,
      detailsAr
    };
    setAuditLog((prev) => [entry, ...prev]);
  }, [currentUser]);

  const handleResetDemo = () => {
    setRequests(INITIAL_REQUESTS);
    setOffers(INITIAL_OFFERS);
    setAuditLog(INITIAL_AUDIT_LOG);
    setSelectedRequestId('PR-1048');
    setSelectedOfferId('OFF-204');
    showToast(isRtl ? 'تمت إعادة ضبط بيانات العرض التجريبي بنجاح' : 'Demo data reset to factory baseline.');
  };

  const loginAsRole = (role, targetScreen = null) => {
    const foundUser = DEMO_USERS.find((u) => u.role === role) || DEMO_USERS[0];
    setCurrentUser(foundUser);
    if (targetScreen) {
      setActiveScreen(targetScreen);
    } else {
      if (role === 'requester' || role === 'officer') setActiveScreen(2);
      else if (role === 'manager') setActiveScreen(5);
      else if (role === 'supplier') setActiveScreen(7);
    }
  };

  const jumpToScreen = (screenNum) => {
    if (screenNum === 1) {
      setActiveScreen(1);
      return;
    }
    if (screenNum === 3) {
      if (!currentUser || currentUser.role !== 'requester') loginAsRole('requester', 3);
      else setActiveScreen(3);
      return;
    }
    if (screenNum === 5) {
      if (!currentUser || currentUser.role !== 'manager') loginAsRole('manager', 5);
      else setActiveScreen(5);
      return;
    }
    if (screenNum === 6 || screenNum === 10 || screenNum === 11) {
      if (!currentUser || (currentUser.role !== 'officer' && currentUser.role !== 'manager')) {
        loginAsRole('officer', screenNum);
      } else {
        setActiveScreen(screenNum);
      }
      return;
    }
    if (screenNum === 7 || screenNum === 8) {
      if (!currentUser || currentUser.role !== 'supplier') loginAsRole('supplier', screenNum);
      else setActiveScreen(screenNum);
      return;
    }
    if (screenNum === 9) {
      if (!currentUser || currentUser.role !== 'officer') loginAsRole('officer', 4);
      else setActiveScreen(4);
      setIsInviteModalOpen(true);
      return;
    }
    if (!currentUser) loginAsRole('officer', screenNum);
    else setActiveScreen(screenNum);
  };

  const bgMain = isDark ? 'bg-[#090B10] text-[#F2F3F5]' : 'bg-[#F2F3F5] text-[#252932]';
  const bgSurface = isDark ? 'bg-[#191C24] border-[#282D3A]' : 'bg-[#FFFFFF] border-[#E2E5EB]';
  const bgSubtle = isDark ? 'bg-[#12151C] border-[#242936]' : 'bg-[#F8F9FB] border-[#E5E8EE]';
  const textMuted = isDark ? 'text-[#949BA8]' : 'text-[#5C6473]';

  const currentRequest = useMemo(
    () => requests.find((r) => r.id === selectedRequestId) || requests[0],
    [requests, selectedRequestId]
  );

  // ==========================================================================
  // SCREEN 01: LOGIN PAGE (3D CREDENTIAL CARDS + SLIDE-OUT SIGN-IN DRAWER)
  // ==========================================================================
  const LoginScreen = () => {
    const [selectedRole, setSelectedRole] = useState(null);
    const [isDrawerOpen, setIsDrawerOpen] = useState(false);
    const [email, setEmail] = useState('');
    const [password, setPassword] = useState('');
    const [showPwd, setShowPwd] = useState(false);
    const [errors, setErrors] = useState({});
    const [authError, setAuthError] = useState('');
    const [loading, setLoading] = useState(false);
    const [activePaperInput, setActivePaperInput] = useState('email');
    const emailInputRef = useRef(null);

    const handleSelectRolePaper = useCallback((role) => {
      setSelectedRole(role);
      setIsDrawerOpen(true);
      const matched = DEMO_USERS.find((u) => u.role === role);
      if (matched) {
        setEmail(matched.email);
        setPassword('Procura@2026');
        setErrors({});
        setAuthError('');
      }
      setTimeout(() => {
        emailInputRef.current?.focus();
      }, 320);
    }, []);

    const handleCloseDrawer = () => {
      setIsDrawerOpen(false);
      setSelectedRole(null);
    };

    // Allow direct keyboard typing even when the user just clicked on the 3D canvas
    const handleCanvasKeyDown = (e) => {
      if (!isDrawerOpen) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === 'Backspace') {
        e.preventDefault();
        if (activePaperInput === 'password') setPassword((p) => p.slice(0, -1));
        else setEmail((em) => em.slice(0, -1));
      } else if (e.key === 'Tab') {
        e.preventDefault();
        setActivePaperInput((prev) => (prev === 'email' ? 'password' : 'email'));
      } else if (e.key.length === 1) {
        e.preventDefault();
        if (activePaperInput === 'password') setPassword((p) => p + e.key);
        else setEmail((em) => em + e.key);
      }
    };

    const handleSubmit = async (e) => {
      e.preventDefault();
      setAuthError('');
      const errs = {};
      if (!email.trim()) errs.email = t.requiredField;
      if (!password.trim()) errs.password = t.requiredField;
      setErrors(errs);
      if (Object.keys(errs).length > 0) return;

      setLoading(true);
      try {
        const res = await ProcuraApiService.login(email, password);
        setLoading(false);
        if (res?.user) {
          loginAsRole(res.user.role);
        } else if (email.includes('@')) {
          loginAsRole(selectedRole || 'requester');
        } else {
          setAuthError(t.invalidCreds);
        }
      } catch (err) {
        setLoading(false);
        setAuthError(err.message || t.invalidCreds);
      }
    };

    return (
      <div className={`min-h-[calc(100vh-44px)] relative overflow-hidden flex ${bgMain}`}>
        {/* Main 3D Role Cards Stage (Full-width initially, reserves full space for right drawer when open so nothing overlaps) */}
        <div
          className={`flex-1 flex flex-col justify-between p-6 lg:p-10 transition-all duration-500 ease-out ${
            isDrawerOpen ? (isRtl ? 'lg:pl-[460px]' : 'lg:pr-[460px]') : ''
          }`}
        >
          <div className="relative z-10 flex items-center justify-between max-w-6xl w-full mx-auto">
            <ProcuraLogo theme={theme} size="lg" />
            <div className="flex items-center gap-2">
              <button
                onClick={() => setLang(lang === 'en' ? 'ar' : 'en')}
                className={`px-3 py-1.5 rounded border text-xs font-semibold flex items-center gap-1.5 transition ${bgSurface} hover:border-[#E32236]`}
              >
                <Globe className="w-3.5 h-3.5 text-[#E32236]" />
                {lang === 'en' ? 'العربية' : 'English'}
              </button>
              <button
                onClick={() => setTheme(isDark ? 'light' : 'dark')}
                className={`p-2 rounded border transition ${bgSurface} hover:border-[#E32236]`}
                aria-label="Toggle Theme"
              >
                {isDark ? <Sun className="w-4 h-4 text-amber-400" /> : <Moon className="w-4 h-4 text-[#252932]" />}
              </button>
            </div>
          </div>

          <div className="relative z-10 mt-6 mb-2 max-w-6xl w-full mx-auto">
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#E32236]/10 border border-[#E32236]/30 text-[#E32236] text-[11px] font-bold tracking-widest uppercase mb-3">
              <ShieldCheck className="w-3.5 h-3.5" />
              {isRtl ? 'بطاقات الاعتماد المؤسسية ثلاثية الأبعاد' : 'ENTERPRISE 3D ACCESS CREDENTIAL CARDS'}
            </div>
            <h1 className="text-3xl lg:text-5xl font-extrabold tracking-tight leading-[1.1] mb-2 max-w-3xl">
              {t.loginHeroTitle}
            </h1>
            <p className={`text-xs sm:text-sm max-w-2xl ${textMuted}`}>
              {isRtl
                ? 'اضغط على أي بطاقة اعتماد في المساحة ثلاثية الأبعاد لسحب لوحة تسجيل الدخول من جانب الشاشة وتعبئة البيانات تلقائياً.'
                : 'Select any 3D enterprise access pass below to pull out the authentication drawer from the right edge of the monitor.'}
            </p>
          </div>

          {/* 3D Interactive Credential Cards Stage */}
          <div
            tabIndex={0}
            onKeyDown={handleCanvasKeyDown}
            className="relative z-10 my-auto max-w-6xl w-full mx-auto outline-none rounded-2xl focus:ring-1 focus:ring-[#E32236]/40"
          >
            <LoginRolePapersThreeScene
              theme={theme}
              lang={lang}
              users={DEMO_USERS}
              selectedRole={selectedRole}
              onSelectRole={handleSelectRolePaper}
              liveEmail={email}
              livePassword={password}
              showPwd={showPwd}
            />
          </div>

          {/* Bottom Quick Role Selector Strip */}
          <div className="relative z-10 flex flex-wrap items-center justify-between gap-2 pt-4 border-t border-black/10 dark:border-white/10 max-w-6xl w-full mx-auto">
            <div className="flex flex-wrap gap-2">
              {DEMO_USERS.map((u) => {
                const active = selectedRole === u.role;
                return (
                  <button
                    key={u.id}
                    type="button"
                    onClick={() => handleSelectRolePaper(u.role)}
                    className={`px-3.5 py-1.5 rounded-lg border text-xs font-bold transition ${
                      active
                        ? 'bg-[#E32236] text-white border-[#E32236] shadow-md shadow-[#E32236]/20'
                        : `${bgSurface} ${textMuted} hover:border-[#E32236]`
                    }`}
                  >
                    {t[`role_${u.role}`]}
                  </button>
                );
              })}
            </div>
            <span className={`text-[11px] font-mono-code ${textMuted}`}>
              {isDrawerOpen
                ? (isRtl ? 'لوحة الدخول نشطة' : 'AUTH DRAWER DEPLOYED')
                : (isRtl ? 'اختر بطاقة للبدء' : 'SELECT A CREDENTIAL CARD TO BEGIN')}
            </span>
          </div>
        </div>

        {/* Slide-Out Sign-In Drawer pulled from the right edge of the monitor */}
        <div
          className={`fixed lg:absolute top-0 bottom-0 ${isRtl ? 'left-0 border-r' : 'right-0 border-l'} z-30 w-full sm:w-[440px] p-7 sm:p-10 shadow-2xl flex flex-col justify-between transition-transform duration-500 ease-out ${bgSurface} ${
            isDrawerOpen
              ? 'translate-x-0 pointer-events-auto'
              : isRtl
              ? '-translate-x-full pointer-events-none'
              : 'translate-x-full pointer-events-none'
          }`}
        >
          <div>
            <div className="flex items-center justify-between pb-5 mb-6 border-b border-black/10 dark:border-white/10">
              <div className="flex items-center gap-2">
                <span className="px-2.5 py-1 rounded bg-[#E32236]/10 border border-[#E32236]/30 text-[#E32236] text-[11px] font-bold uppercase tracking-wider">
                  {selectedRole ? t[`role_${selectedRole}`] : ''}
                </span>
                <span className={`text-xs font-mono-code ${textMuted}`}>
                  {DEMO_USERS.find((u) => u.role === selectedRole)?.id}
                </span>
              </div>

              <button
                type="button"
                onClick={handleCloseDrawer}
                className={`p-2 rounded-lg border transition ${bgSubtle} hover:border-[#E32236] hover:text-[#E32236]`}
                title={t.cancel}
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="mb-6">
              <h2 className="text-2xl font-extrabold tracking-tight mb-1.5">{t.welcomeBack}</h2>
              <p className={`text-xs leading-relaxed ${textMuted}`}>{t.signInSub}</p>
            </div>

            {authError && (
              <div className="mb-4 p-3 rounded-lg bg-[#E32236]/10 border border-[#E32236]/40 text-[#E32236] text-xs flex items-center gap-2">
                <AlertTriangle className="w-4 h-4 shrink-0" />
                <span>{authError}</span>
              </div>
            )}

            <form onSubmit={handleSubmit} className="space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase tracking-wider mb-1.5">{t.email}</label>
                <input
                  ref={emailInputRef}
                  type="email"
                  value={email}
                  onFocus={() => setActivePaperInput('email')}
                  onChange={(e) => setEmail(e.target.value)}
                  className={`w-full px-3.5 py-2.5 rounded-lg border text-sm font-mono-code outline-none transition focus:border-[#E32236] ${bgSubtle}`}
                />
                {errors.email && <p className="text-xs text-[#E32236] mt-1">{errors.email}</p>}
              </div>

              <div>
                <label className="block text-xs font-bold uppercase tracking-wider mb-1.5">{t.password}</label>
                <div className="relative">
                  <input
                    type={showPwd ? 'text' : 'password'}
                    value={password}
                    onFocus={() => setActivePaperInput('password')}
                    onChange={(e) => setPassword(e.target.value)}
                    className={`w-full px-3.5 py-2.5 rounded-lg border text-sm font-mono-code outline-none transition focus:border-[#E32236] ${bgSubtle}`}
                  />
                  <button
                    type="button"
                    onClick={() => setShowPwd(!showPwd)}
                    className={`absolute top-1/2 -translate-y-1/2 ${isRtl ? 'left-3' : 'right-3'} ${textMuted} hover:text-[#E32236]`}
                  >
                    {showPwd ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
                  </button>
                </div>
                {errors.password && <p className="text-xs text-[#E32236] mt-1">{errors.password}</p>}
              </div>

              <button
                type="submit"
                disabled={loading}
                className="w-full py-3 px-4 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-lg shadow-[#E32236]/25 transition disabled:opacity-60"
              >
                {loading ? (
                  <>
                    <RefreshCw className="w-4 h-4 animate-spin" />
                    {t.signingIn}
                  </>
                ) : (
                  <>
                    {t.signIn}
                    {isRtl ? <ArrowLeft className="w-4 h-4" /> : <ArrowRight className="w-4 h-4" />}
                  </>
                )}
              </button>
            </form>
          </div>

          <div className="pt-5 border-t border-black/10 dark:border-white/10">
            <span className="text-xs font-bold uppercase tracking-wider text-[#E32236] block mb-1">
              {t.demoAccounts}
            </span>
            <p className={`text-xs ${textMuted}`}>{t.demoNotice}</p>
          </div>
        </div>
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 02: REQUESTS LIST (EDITORIAL DATA LEDGER)
  // ==========================================================================
  const RequestsListScreen = () => {
    const [searchQuery, setSearchQuery] = useState('');
    const [statusFilter, setStatusFilter] = useState('ALL');
    const [viewState, setViewState] = useState('normal');

    const visibleRequests = useMemo(() => {
      let list = requests;
      if (currentUser?.role === 'requester') {
        list = list.filter((r) => r.requesterId === currentUser.id);
      }
      if (statusFilter !== 'ALL') {
        list = list.filter((r) => r.status === statusFilter);
      }
      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase();
        list = list.filter(
          (r) =>
            r.title.toLowerCase().includes(q) ||
            r.titleAr.includes(q) ||
            r.id.toLowerCase().includes(q)
        );
      }
      return list;
    }, [requests, currentUser, statusFilter, searchQuery]);

    return (
      <div className="space-y-6">
        <div className="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-black/10 dark:border-white/10">
          <div>
            <div className="text-xs font-bold uppercase tracking-widest text-[#E32236] mb-1">
              02 // REQUISITION LEDGER
            </div>
            <h1 className="text-3xl font-extrabold tracking-tight">{t.requestsTitle}</h1>
            <p className={`text-sm mt-1 ${textMuted}`}>{t.requestsSubtitle}</p>
          </div>

          <div className="flex flex-wrap items-center gap-3">
            <div className={`flex items-center gap-1 p-1 rounded-lg border text-xs ${bgSurface}`}>
              <span className={`px-2 font-medium ${textMuted}`}>{t.simulateStates}</span>
              {['normal', 'loading', 'empty', 'error'].map((st) => (
                <button
                  key={st}
                  onClick={() => setViewState(st)}
                  className={`px-2.5 py-1 rounded font-semibold transition ${
                    viewState === st ? 'bg-[#E32236] text-white' : `${textMuted} hover:text-[#E32236]`
                  }`}
                >
                  {t[`state${st.charAt(0).toUpperCase() + st.slice(1)}`]}
                </button>
              ))}
            </div>

            {currentUser?.role === 'requester' && (
              <button
                onClick={() => setActiveScreen(3)}
                className="px-4 py-2.5 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-bold flex items-center gap-2 shadow-lg shadow-[#E32236]/20 transition"
              >
                <Plus className="w-4 h-4" />
                {t.newRequest}
              </button>
            )}
          </div>
        </div>

        <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <div className="relative flex-1">
            <Search className={`w-4 h-4 absolute top-1/2 -translate-y-1/2 ${isRtl ? 'right-3.5' : 'left-3.5'} ${textMuted}`} />
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder={t.searchPlaceholder}
              className={`w-full ${isRtl ? 'pr-10 pl-4' : 'pl-10 pr-4'} py-2.5 rounded-lg border text-sm outline-none focus:border-[#E32236] ${bgSurface}`}
            />
          </div>

          <select
            value={statusFilter}
            onChange={(e) => setStatusFilter(e.target.value)}
            className={`px-4 py-2.5 rounded-lg border text-sm font-medium outline-none focus:border-[#E32236] ${bgSurface}`}
          >
            <option value="ALL">{t.allStatuses}</option>
            {['Draft', 'Submitted', 'OffersReceived', 'Compared', 'PendingApproval', 'Approved', 'Rejected'].map((st) => (
              <option key={st} value={st}>{t[`status_${st}`]}</option>
            ))}
          </select>
        </div>

        {viewState === 'loading' ? (
          <div className={`rounded-xl border p-16 text-center ${bgSurface}`}>
            <RefreshCw className="w-8 h-8 text-[#E32236] animate-spin mx-auto mb-3" />
            <p className="text-sm font-semibold">{t.loadingData}</p>
          </div>
        ) : viewState === 'error' ? (
          <div className={`rounded-xl border p-16 text-center ${bgSurface}`}>
            <AlertTriangle className="w-8 h-8 text-[#E32236] mx-auto mb-3" />
            <p className="text-sm font-semibold mb-4">{t.errorLoading}</p>
            <button
              onClick={() => setViewState('normal')}
              className="px-4 py-2 rounded-lg bg-[#E32236] text-white text-xs font-bold"
            >
              {t.retry}
            </button>
          </div>
        ) : viewState === 'empty' || visibleRequests.length === 0 ? (
          <div className={`rounded-xl border p-16 text-center ${bgSurface}`}>
            <FileText className={`w-10 h-10 mx-auto mb-3 ${textMuted}`} />
            <p className="text-base font-bold">{t.noRequests}</p>
          </div>
        ) : (
          <div className={`rounded-xl border overflow-hidden ${bgSurface}`}>
            <div className="overflow-x-auto">
              <table className="w-full text-start border-collapse">
                <thead>
                  <tr className={`border-b text-[11px] font-bold uppercase tracking-wider ${bgSubtle} ${textMuted}`}>
                    <th className="py-3.5 px-5 text-start">{t.reqId}</th>
                    <th className="py-3.5 px-5 text-start">{t.reqTitle}</th>
                    <th className="py-3.5 px-5 text-start">{t.quantity}</th>
                    <th className="py-3.5 px-5 text-start">{t.estBudget}</th>
                    <th className="py-3.5 px-5 text-start">{t.status}</th>
                    <th className="py-3.5 px-5 text-start">{t.createdDate}</th>
                    <th className="py-3.5 px-5 text-end"></th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-black/5 dark:divide-white/5 text-sm">
                  {visibleRequests.map((req) => (
                    <tr
                      key={req.id}
                      onClick={() => {
                        setSelectedRequestId(req.id);
                        setActiveScreen(4);
                      }}
                      className="cursor-pointer transition hover:bg-[#E32236]/[0.04] group"
                    >
                      <td className="py-4 px-5 font-mono-code font-bold text-[#E32236]">{req.id}</td>
                      <td className="py-4 px-5">
                        <div className="font-bold group-hover:text-[#E32236] transition">
                          {isRtl ? req.titleAr : req.title}
                        </div>
                        <div className={`text-xs mt-0.5 ${textMuted}`}>
                          {isRtl ? req.requesterNameAr : req.requesterName}
                        </div>
                      </td>
                      <td className="py-4 px-5 font-mono-code font-semibold">
                        {req.quantity} <span className={`text-xs font-normal ${textMuted}`}>{t.units}</span>
                      </td>
                      <td className="py-4 px-5 font-mono-code font-bold">
                        ${req.estimatedBudget.toLocaleString()}
                      </td>
                      <td className="py-4 px-5">
                        <StatusBadge status={req.status} lang={lang} />
                      </td>
                      <td className={`py-4 px-5 font-mono-code text-xs ${textMuted}`}>{req.createdDate}</td>
                      <td className="py-4 px-5 text-end">
                        {isRtl ? (
                          <ChevronLeft className="w-4 h-4 inline text-[#E32236]" />
                        ) : (
                          <ChevronRight className="w-4 h-4 inline text-[#E32236]" />
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 03: CREATE REQUEST (REQUESTER ONLY — EDITORIAL SPLIT FORM)
  // ==========================================================================
  const CreateRequestScreen = () => {
    const [title, setTitle] = useState('');
    const [description, setDescription] = useState('');
    const [quantity, setQuantity] = useState('');
    const [budget, setBudget] = useState('');
    const [reason, setReason] = useState('');
    const [deliveryDate, setDeliveryDate] = useState('');
    const [errors, setErrors] = useState({});

    const validateForm = () => {
      const errs = {};
      if (!title.trim()) errs.title = t.requiredField;
      if (!quantity || Number(quantity) <= 0) errs.quantity = t.mustBePositive;
      if (!budget || Number(budget) <= 0) errs.budget = t.mustBePositive;
      if (!reason.trim()) errs.reason = t.requiredField;
      setErrors(errs);
      return Object.keys(errs).length === 0;
    };

    const handleCreate = (targetStatus) => {
      if (!validateForm()) return;
      const newId = `PR-${Math.floor(1051 + Math.random() * 899)}`;
      const newReq = {
        id: newId,
        title: title.trim(),
        titleAr: title.trim(),
        description: description.trim() || 'Standard enterprise procurement specification.',
        descriptionAr: description.trim() || 'مواصفات شراء مؤسسية قياسية.',
        quantity: Number(quantity),
        estimatedBudget: Number(budget),
        reason: reason.trim(),
        reasonAr: reason.trim(),
        deliveryDate: deliveryDate || '2026-12-30',
        requesterId: currentUser?.id || 'USR-01',
        requesterName: currentUser?.name || 'Belal Khalil',
        requesterNameAr: currentUser?.nameAr || 'بلال خليل',
        status: targetStatus,
        createdDate: new Date().toISOString().split('T')[0],
        invitedSupplierIds: []
      };

      setRequests((prev) => [newReq, ...prev]);
      setSelectedRequestId(newId);
      addAuditEntry(
        targetStatus === 'Draft' ? 'Saved Request Draft' : 'Created & Submitted Request',
        targetStatus === 'Draft' ? 'حفظ مسودة طلب' : 'إنشاء وإرسال طلب شراء',
        newId,
        `${newReq.title} (${newReq.quantity} units, $${newReq.estimatedBudget.toLocaleString()})`,
        `${newReq.titleAr} (${newReq.quantity} وحدة، $${newReq.estimatedBudget.toLocaleString()})`
      );
      setActiveScreen(4);
      showToast(
        targetStatus === 'Draft'
          ? (isRtl ? 'تم حفظ الطلب كمسودة' : 'Purchase request saved as Draft.')
          : (isRtl ? 'تم إرسال طلب الشراء بنجاح' : 'Purchase request submitted to Procurement.')
      );
    };

    return (
      <div className="space-y-6">
        <div className="flex items-center justify-between pb-5 border-b border-black/10 dark:border-white/10">
          <div>
            <div className="text-xs font-bold uppercase tracking-widest text-[#E32236] mb-1">
              03 // REQUISITION ORIGINATION
            </div>
            <h1 className="text-3xl font-extrabold tracking-tight">{t.createReqTitle}</h1>
            <p className={`text-sm mt-1 ${textMuted}`}>{t.createReqSub}</p>
          </div>
          <button
            onClick={() => setActiveScreen(2)}
            className={`px-3.5 py-2 rounded-lg border text-xs font-semibold ${bgSurface} hover:border-[#E32236]`}
          >
            {t.cancel}
          </button>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <div className={`lg:col-span-8 p-6 lg:p-8 rounded-xl border space-y-5 ${bgSurface}`}>
            <div>
              <label className="block text-xs font-bold uppercase tracking-wider mb-1.5">
                {t.fieldTitle} <span className="text-[#E32236]">*</span>
              </label>
              <input
                type="text"
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder={t.fieldTitlePlaceholder}
                className={`w-full px-4 py-2.5 rounded-lg border text-sm outline-none focus:border-[#E32236] ${bgSubtle}`}
              />
              {errors.title && <p className="text-xs text-[#E32236] mt-1">{errors.title}</p>}
            </div>

            <div>
              <label className="block text-xs font-bold uppercase tracking-wider mb-1.5">{t.fieldDesc}</label>
              <textarea
                rows={4}
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                placeholder={t.fieldDescPlaceholder}
                className={`w-full px-4 py-2.5 rounded-lg border text-sm outline-none focus:border-[#E32236] ${bgSubtle}`}
              />
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label className="block text-xs font-bold uppercase tracking-wider mb-1.5">
                  {t.fieldQty} <span className="text-[#E32236]">*</span>
                </label>
                <input
                  type="number"
                  min="1"
                  value={quantity}
                  onChange={(e) => setQuantity(e.target.value)}
                  placeholder="10"
                  className={`w-full px-4 py-2.5 rounded-lg border text-sm font-mono-code outline-none focus:border-[#E32236] ${bgSubtle}`}
                />
                {errors.quantity && <p className="text-xs text-[#E32236] mt-1">{errors.quantity}</p>}
              </div>

              <div>
                <label className="block text-xs font-bold uppercase tracking-wider mb-1.5">
                  {t.fieldBudget} <span className="text-[#E32236]">*</span>
                </label>
                <input
                  type="number"
                  min="1"
                  value={budget}
                  onChange={(e) => setBudget(e.target.value)}
                  placeholder="15000"
                  className={`w-full px-4 py-2.5 rounded-lg border text-sm font-mono-code outline-none focus:border-[#E32236] ${bgSubtle}`}
                />
                {errors.budget && <p className="text-xs text-[#E32236] mt-1">{errors.budget}</p>}
              </div>

              <div>
                <label className="block text-xs font-bold uppercase tracking-wider mb-1.5">{t.fieldDeliveryDate}</label>
                <input
                  type="date"
                  value={deliveryDate}
                  onChange={(e) => setDeliveryDate(e.target.value)}
                  className={`w-full px-4 py-2.5 rounded-lg border text-sm font-mono-code outline-none focus:border-[#E32236] ${bgSubtle}`}
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-bold uppercase tracking-wider mb-1.5">
                {t.fieldReason} <span className="text-[#E32236]">*</span>
              </label>
              <input
                type="text"
                value={reason}
                onChange={(e) => setReason(e.target.value)}
                placeholder={t.fieldReasonPlaceholder}
                className={`w-full px-4 py-2.5 rounded-lg border text-sm outline-none focus:border-[#E32236] ${bgSubtle}`}
              />
              {errors.reason && <p className="text-xs text-[#E32236] mt-1">{errors.reason}</p>}
            </div>

            <div className="pt-4 border-t border-black/10 dark:border-white/10 flex flex-wrap items-center justify-end gap-3">
              <button
                type="button"
                onClick={() => handleCreate('Draft')}
                className={`px-5 py-2.5 rounded-lg border text-sm font-semibold transition ${bgSubtle} hover:border-[#E32236]`}
              >
                {t.saveDraft}
              </button>
              <button
                type="button"
                onClick={() => handleCreate('Submitted')}
                className="px-6 py-2.5 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-sm font-semibold shadow-lg shadow-[#E32236]/25 transition flex items-center gap-2"
              >
                <Send className="w-4 h-4" />
                {t.submitRequest}
              </button>
            </div>
          </div>

          <div className={`lg:col-span-4 p-6 rounded-xl border flex flex-col justify-between ${bgSurface}`}>
            <div>
              <div className="text-xs font-bold uppercase tracking-widest text-[#E32236] mb-3">
                {isRtl ? 'ملخص المواصفات الفورية' : 'LIVE REQUISITION BRIEF'}
              </div>
              <div className={`p-4 rounded-lg border space-y-3 ${bgSubtle}`}>
                <div>
                  <span className={`text-[11px] uppercase ${textMuted}`}>{t.reqTitle}</span>
                  <p className="font-bold text-sm mt-0.5">{title || '—'}</p>
                </div>
                <div className="grid grid-cols-2 gap-3 pt-2 border-t border-black/5 dark:border-white/5">
                  <div>
                    <span className={`text-[11px] uppercase ${textMuted}`}>{t.quantity}</span>
                    <p className="font-mono-code font-bold text-base">{quantity || '0'} {t.units}</p>
                  </div>
                  <div>
                    <span className={`text-[11px] uppercase ${textMuted}`}>{t.estBudget}</span>
                    <p className="font-mono-code font-bold text-base text-[#E32236]">
                      ${Number(budget || 0).toLocaleString()}
                    </p>
                  </div>
                </div>
                <div className="pt-2 border-t border-black/5 dark:border-white/5">
                  <span className={`text-[11px] uppercase ${textMuted}`}>{t.requesterLabel}</span>
                  <p className="font-semibold text-xs mt-0.5">
                    {isRtl ? currentUser?.nameAr : currentUser?.name}
                  </p>
                </div>
              </div>
            </div>

            <div className={`mt-6 p-4 rounded-lg border text-xs leading-relaxed ${bgSubtle} ${textMuted}`}>
              <ShieldCheck className="w-5 h-5 text-[#E32236] mb-2" />
              {isRtl
                ? 'سيتم تسجيل الطلب في سجل التدقيق المؤسسي وإحالته تلقائياً إلى مسؤول المشتريات فور الإرسال.'
                : 'Submitting this requisition logs an immutable audit event and routes specifications to Strategic Procurement.'}
            </div>
          </div>
        </div>
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 11: SUPPLIER COMPARISON TABLE (USABLE 3D DECISION MATRIX + TABLE)
  // ==========================================================================
  const SupplierComparisonView = ({ requestId, standalone = false }) => {
    const reqOffers = offers.filter((o) => o.requestId === requestId);
    const validPrices = reqOffers.filter((o) => o.reviewed && o.totalPrice > 0).map((o) => o.totalPrice);
    const validDays = reqOffers.filter((o) => o.reviewed && o.deliveryDays > 0).map((o) => o.deliveryDays);

    const minPrice = validPrices.length ? Math.min(...validPrices) : null;
    const minDays = validDays.length ? Math.min(...validDays) : null;

    const [priority, setPriority] = useState('balanced');
    const [selectedOffer, setSelectedOffer] = useState(reqOffers[0]?.id || null);
    const [use3D, setUse3D] = useState(true);

    return (
      <div className="space-y-5">
        {standalone && (
          <div className="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-black/10 dark:border-white/10">
            <div>
              <div className="text-xs font-bold uppercase tracking-widest text-[#E32236] mb-1">
                11 // COMMERCIAL EVALUATION MATRIX
              </div>
              <h1 className="text-3xl font-extrabold tracking-tight">{t.comparisonTitle}</h1>
              <p className={`text-sm mt-1 ${textMuted}`}>{t.comparisonSub}</p>
            </div>
            <button
              onClick={() => setActiveScreen(4)}
              className={`px-4 py-2 rounded-lg border text-xs font-semibold ${bgSurface} hover:border-[#E32236]`}
            >
              {t.backToRequests} ({requestId})
            </button>
          </div>
        )}

        {reqOffers.length === 0 ? (
          <div className={`p-8 rounded-xl border text-center text-sm ${bgSubtle} ${textMuted}`}>
            {t.noOffersYet}
          </div>
        ) : (
          <>
            <div className={`rounded-xl border p-4 space-y-3 ${bgSubtle}`}>
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div className="flex flex-wrap items-center gap-1.5">
                  {[
                    { id: 'balanced', label: t.priorityBalanced },
                    { id: 'price', label: t.priorityPrice },
                    { id: 'delivery', label: t.priorityDelivery },
                    { id: 'warranty', label: t.priorityWarranty }
                  ].map((p) => (
                    <button
                      key={p.id}
                      onClick={() => setPriority(p.id)}
                      className={`px-3 py-1.5 rounded-lg text-xs font-bold border transition ${
                        priority === p.id
                          ? 'bg-[#E32236] text-white border-[#E32236]'
                          : `${bgSurface} ${textMuted} hover:border-[#E32236]`
                      }`}
                    >
                      {p.label}
                    </button>
                  ))}
                </div>

                <button
                  onClick={() => setUse3D(!use3D)}
                  className={`px-3 py-1.5 rounded-lg border text-xs font-bold flex items-center gap-1.5 ${bgSurface} hover:border-[#E32236]`}
                >
                  <Box className="w-3.5 h-3.5 text-[#E32236]" />
                  <span>{use3D ? t.viewClassic : t.view3d}</span>
                </button>
              </div>

              {use3D && (
                <>
                  <ComparisonThreeScene
                    theme={theme}
                    offers={reqOffers}
                    priority={priority}
                    selectedOfferId={selectedOffer}
                    onSelectOffer={setSelectedOffer}
                  />
                  <div className={`text-[11px] flex items-center justify-between ${textMuted}`}>
                    <span>{t.clickColumnHint}</span>
                    <span className="font-mono-code text-[#E32236] font-bold">{requestId}</span>
                  </div>
                </>
              )}
            </div>

            <div className={`rounded-xl border overflow-hidden ${bgSurface}`}>
              <div className="overflow-x-auto">
                <table className="w-full border-collapse text-start">
                  <thead>
                    <tr className={`border-b ${bgSubtle}`}>
                      <th className={`p-4 text-start text-xs font-bold uppercase tracking-wider w-56 ${textMuted}`}>
                        {t.categoryCol}
                      </th>
                      {reqOffers.map((offer) => {
                        const isSelected = selectedOffer === offer.id;
                        return (
                          <th
                            key={offer.id}
                            onClick={() => setSelectedOffer(offer.id)}
                            className={`p-4 text-start min-w-[210px] border-s border-black/5 dark:border-white/5 cursor-pointer transition ${
                              isSelected ? 'bg-[#E32236]/10' : 'hover:bg-black/[0.02] dark:hover:bg-white/[0.02]'
                            }`}
                          >
                            <div className="flex items-center justify-between gap-2">
                              <span className={`font-bold text-base ${isSelected ? 'text-[#E32236]' : ''}`}>
                                {offer.supplierName}
                              </span>
                              {!offer.reviewed && (
                                <span className="px-2 py-0.5 rounded bg-amber-500/15 text-amber-500 border border-amber-500/30 text-[11px] font-bold">
                                  {t.notReviewedBadge}
                                </span>
                              )}
                            </div>
                            <div className={`text-xs font-mono-code mt-0.5 ${textMuted}`}>{offer.id}</div>
                          </th>
                        );
                      })}
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-black/5 dark:divide-white/5 text-sm">
                    <tr>
                      <td className="p-4 font-semibold">{t.totalPrice}</td>
                      {reqOffers.map((offer) => {
                        const isCheapest = offer.reviewed && minPrice !== null && offer.totalPrice === minPrice;
                        return (
                          <td
                            key={offer.id}
                            onClick={() => setSelectedOffer(offer.id)}
                            className={`p-4 font-mono-code border-s border-black/5 dark:border-white/5 cursor-pointer ${
                              isCheapest ? 'bg-emerald-500/10' : ''
                            }`}
                          >
                            <div className="flex items-center gap-2">
                              <span className="text-lg font-extrabold">
                                {offer.totalPrice ? `$${offer.totalPrice.toLocaleString()} ${offer.currency}` : '-'}
                              </span>
                              {isCheapest && (
                                <span className="px-2 py-0.5 rounded bg-emerald-500 text-white text-[10px] font-bold uppercase">
                                  {t.cheapestBadge}
                                </span>
                              )}
                            </div>
                          </td>
                        );
                      })}
                    </tr>

                    <tr>
                      <td className="p-4 font-semibold">{t.deliveryDuration}</td>
                      {reqOffers.map((offer) => {
                        const isFastest = offer.reviewed && minDays !== null && offer.deliveryDays === minDays;
                        return (
                          <td
                            key={offer.id}
                            onClick={() => setSelectedOffer(offer.id)}
                            className={`p-4 font-mono-code border-s border-black/5 dark:border-white/5 cursor-pointer ${
                              isFastest ? 'bg-sky-500/10' : ''
                            }`}
                          >
                            <div className="flex items-center gap-2">
                              <span className="font-bold">
                                {offer.deliveryDays ? `${offer.deliveryDays} ${t.daysUnit}` : '-'}
                              </span>
                              {isFastest && (
                                <span className="px-2 py-0.5 rounded bg-sky-500 text-white text-[10px] font-bold uppercase">
                                  {t.fastestBadge}
                                </span>
                              )}
                            </div>
                          </td>
                        );
                      })}
                    </tr>

                    <tr>
                      <td className="p-4 font-semibold">{t.paymentTerms}</td>
                      {reqOffers.map((offer) => (
                        <td
                          key={offer.id}
                          onClick={() => setSelectedOffer(offer.id)}
                          className="p-4 border-s border-black/5 dark:border-white/5 cursor-pointer"
                        >
                          {offer.paymentTerms && offer.paymentTerms.trim() ? offer.paymentTerms : '-'}
                        </td>
                      ))}
                    </tr>

                    <tr>
                      <td className="p-4 font-semibold">{t.warrantyDuration}</td>
                      {reqOffers.map((offer) => (
                        <td
                          key={offer.id}
                          onClick={() => setSelectedOffer(offer.id)}
                          className="p-4 font-mono-code border-s border-black/5 dark:border-white/5 cursor-pointer"
                        >
                          {offer.warrantyMonths ? `${offer.warrantyMonths} ${t.monthsUnit}` : '-'}
                        </td>
                      ))}
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </>
        )}
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 04: REQUEST DETAILS (CENTRAL PROCUREMENT COMMAND VIEW + 3D TRACKER)
  // ==========================================================================
  const RequestDetailsScreen = () => {
    const req = currentRequest;
    const reqOffers = offers.filter((o) => o.requestId === req.id);
    const reqAudit = auditLog.filter((a) => a.requestId === req.id).slice(0, 10);
    const [rejectReason, setRejectReason] = useState('');
    const [showRejectBox, setShowRejectBox] = useState(false);

    const stages = ['Draft', 'Submitted', 'OffersReceived', 'Compared', 'PendingApproval', req.status === 'Rejected' ? 'Rejected' : 'Approved'];
    const currentStageIdx = Math.max(0, stages.indexOf(req.status));
    const [selectedStageIdx, setSelectedStageIdx] = useState(currentStageIdx);
    const [use3DTracker, setUse3DTracker] = useState(true);

    useEffect(() => {
      setSelectedStageIdx(currentStageIdx);
    }, [currentStageIdx, req.id]);

    const updateRequestStatus = (nextStatus, logAction, logActionAr, logDetails, logDetailsAr) => {
      setRequests((prev) =>
        prev.map((r) => (r.id === req.id ? { ...r, status: nextStatus } : r))
      );
      addAuditEntry(logAction, logActionAr, req.id, logDetails, logDetailsAr);
      showToast(isRtl ? logActionAr : logAction);
    };

    const handleDeleteDraft = () => {
      setRequests((prev) => prev.filter((r) => r.id !== req.id));
      addAuditEntry('Deleted Draft', 'حذف مسودة', req.id, `Deleted draft ${req.id}`, `تم حذف المسودة ${req.id}`);
      setActiveScreen(2);
      showToast(isRtl ? 'تم حذف المسودة' : 'Draft deleted.');
    };

    return (
      <div className="space-y-6">
        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-black/10 dark:border-white/10">
          <div>
            <button
              onClick={() => setActiveScreen(2)}
              className={`text-xs font-semibold flex items-center gap-1 mb-2 ${textMuted} hover:text-[#E32236]`}
            >
              {isRtl ? <ArrowRight className="w-3.5 h-3.5" /> : <ArrowLeft className="w-3.5 h-3.5" />}
              {t.backToRequests}
            </button>
            <div className="flex flex-wrap items-center gap-3">
              <span className="font-mono-code text-lg font-extrabold text-[#E32236]">{req.id}</span>
              <h1 className="text-2xl lg:text-3xl font-extrabold tracking-tight">
                {isRtl ? req.titleAr : req.title}
              </h1>
              <StatusBadge status={req.status} lang={lang} />
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-2.5">
            {currentUser?.role === 'requester' && req.status === 'Draft' && (
              <>
                <button
                  onClick={() =>
                    updateRequestStatus(
                      'Submitted',
                      'Submitted Request',
                      'إرسال طلب شراء',
                      'Status changed from Draft -> Submitted',
                      'تغيير الحالة من مسودة -> تم الإرسال'
                    )
                  }
                  className="px-4 py-2 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-bold flex items-center gap-1.5"
                >
                  <Send className="w-3.5 h-3.5" />
                  {t.submitRequest}
                </button>
                <button
                  onClick={handleDeleteDraft}
                  className="px-4 py-2 rounded-lg border border-[#E32236]/40 text-[#E32236] hover:bg-[#E32236]/10 text-xs font-bold flex items-center gap-1.5"
                >
                  <Trash2 className="w-3.5 h-3.5" />
                  {t.deleteDraft}
                </button>
              </>
            )}

            {currentUser?.role === 'officer' && (
              <>
                {(req.status === 'Submitted' || req.status === 'OffersReceived') && (
                  <button
                    onClick={() => setIsInviteModalOpen(true)}
                    className={`px-4 py-2 rounded-lg border text-xs font-bold flex items-center gap-1.5 ${bgSurface} hover:border-[#E32236]`}
                  >
                    <Users className="w-3.5 h-3.5 text-[#E32236]" />
                    {t.inviteSuppliers}
                  </button>
                )}
                {reqOffers.length > 0 && (
                  <button
                    onClick={() => setActiveScreen(11)}
                    className={`px-4 py-2 rounded-lg border text-xs font-bold flex items-center gap-1.5 ${bgSurface} hover:border-[#E32236]`}
                  >
                    <Layers className="w-3.5 h-3.5 text-[#E32236]" />
                    {t.openComparison}
                  </button>
                )}
                {(req.status === 'OffersReceived' || req.status === 'Compared') && reqOffers.length > 0 && (
                  <button
                    onClick={() =>
                      updateRequestStatus(
                        'PendingApproval',
                        'Sent for Approval',
                        'إرسال للاعتماد',
                        `Status changed from ${req.status} -> Pending Approval`,
                        'تم إرسال الطلب إلى المدير للاعتماد'
                      )
                    }
                    className="px-4 py-2 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-bold flex items-center gap-1.5 shadow-lg shadow-[#E32236]/20"
                  >
                    <Send className="w-3.5 h-3.5" />
                    {t.sendForApproval}
                  </button>
                )}
              </>
            )}

            {currentUser?.role === 'manager' && req.status === 'PendingApproval' && (
              <>
                <button
                  onClick={() =>
                    updateRequestStatus(
                      'Approved',
                      'Approved Request',
                      'اعتماد الطلب',
                      'Status changed from Pending Approval -> Approved',
                      'تمت الموافقة الرسمية على الطلب'
                    )
                  }
                  className="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center gap-1.5"
                >
                  <CheckCircle2 className="w-3.5 h-3.5" />
                  {t.approveRequest}
                </button>
                <button
                  onClick={() => setShowRejectBox(!showRejectBox)}
                  className="px-4 py-2 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-bold flex items-center gap-1.5"
                >
                  <XCircle className="w-3.5 h-3.5" />
                  {t.rejectRequest}
                </button>
              </>
            )}
          </div>
        </div>

        {showRejectBox && (
          <div className={`p-4 rounded-xl border border-[#E32236] space-y-3 ${bgSurface}`}>
            <label className="block text-xs font-bold text-[#E32236]">{t.rejectReasonLabel}</label>
            <input
              type="text"
              value={rejectReason}
              onChange={(e) => setRejectReason(e.target.value)}
              placeholder={t.rejectReasonPlaceholder}
              className={`w-full px-3.5 py-2 rounded-lg border text-sm ${bgSubtle}`}
            />
            <div className="flex justify-end gap-2">
              <button onClick={() => setShowRejectBox(false)} className="px-3 py-1.5 text-xs font-semibold">
                {t.cancel}
              </button>
              <button
                onClick={() => {
                  if (!rejectReason.trim()) return;
                  updateRequestStatus(
                    'Rejected',
                    'Rejected Request',
                    'رفض الطلب',
                    `Rejected: ${rejectReason}`,
                    `مرفوض: ${rejectReason}`
                  );
                  setShowRejectBox(false);
                }}
                className="px-4 py-1.5 rounded-lg bg-[#E32236] text-white text-xs font-bold"
              >
                {t.rejectRequest}
              </button>
            </div>
          </div>
        )}

        {/* B. Interactive 6-Stage Workflow Timeline (3D Tracker + Classic 2D Toggle) */}
        <div className={`p-5 rounded-xl border space-y-4 ${bgSurface}`}>
          <div className="flex items-center justify-between">
            <div className="text-xs font-bold uppercase tracking-wider text-[#E32236]">
              {t.workflowTimeline}
            </div>
            <button
              onClick={() => setUse3DTracker(!use3DTracker)}
              className={`px-3 py-1 rounded-lg border text-xs font-bold flex items-center gap-1.5 ${bgSubtle} hover:border-[#E32236]`}
            >
              <Box className="w-3.5 h-3.5 text-[#E32236]" />
              <span>{use3DTracker ? t.viewClassic : t.view3d}</span>
            </button>
          </div>

          {use3DTracker && (
            <div className={`rounded-xl border overflow-hidden ${bgSubtle}`}>
              <WorkflowStageThreeScene
                theme={theme}
                stages={stages}
                currentStageIdx={currentStageIdx}
                selectedStageIdx={selectedStageIdx}
                onSelectStage={setSelectedStageIdx}
              />
              <div className={`px-4 py-2 border-t border-black/5 dark:border-white/5 flex flex-wrap items-center justify-between gap-2 text-xs ${textMuted}`}>
                <span>{t.clickStageHint}</span>
                <span className="font-bold text-[#E32236]">
                  0{selectedStageIdx + 1} — {t[`status_${stages[selectedStageIdx]}`]}
                </span>
              </div>
            </div>
          )}

          <div className="grid grid-cols-2 sm:grid-cols-6 gap-2">
            {stages.map((st, idx) => {
              const isCompleted = idx <= currentStageIdx;
              const isCurrent = idx === currentStageIdx;
              const isInspected = idx === selectedStageIdx;
              return (
                <button
                  key={st}
                  type="button"
                  onClick={() => setSelectedStageIdx(idx)}
                  className={`p-3 rounded-lg border text-start transition ${
                    isInspected
                      ? 'border-[#E32236] bg-[#E32236]/10 ring-1 ring-[#E32236]'
                      : isCompleted
                      ? 'border-emerald-500/40 bg-emerald-500/5'
                      : `${bgSubtle} opacity-60 hover:opacity-100`
                  }`}
                >
                  <div className="flex items-center justify-between mb-1">
                    <span className="font-mono-code text-[11px] font-bold">0{idx + 1}</span>
                    {isCompleted && <CheckCircle2 className={`w-3.5 h-3.5 ${isCurrent ? 'text-[#E32236]' : 'text-emerald-500'}`} />}
                  </div>
                  <div className="text-xs font-bold truncate">{t[`status_${st}`]}</div>
                </button>
              );
            })}
          </div>
        </div>

        {/* A. Request Information + C. Supplier Offers Grid */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <div className={`lg:col-span-5 p-6 rounded-xl border space-y-4 ${bgSurface}`}>
            <h2 className="text-base font-bold border-b border-black/10 dark:border-white/10 pb-3">
              {t.reqInfoSection}
            </h2>
            <p className={`text-sm leading-relaxed ${textMuted}`}>
              {isRtl ? req.descriptionAr : req.description}
            </p>
            <div className="grid grid-cols-2 gap-4 pt-2">
              <div className={`p-3 rounded-lg border ${bgSubtle}`}>
                <span className={`text-[11px] uppercase ${textMuted}`}>{t.quantity}</span>
                <p className="font-mono-code font-bold text-base mt-0.5">{req.quantity} {t.units}</p>
              </div>
              <div className={`p-3 rounded-lg border ${bgSubtle}`}>
                <span className={`text-[11px] uppercase ${textMuted}`}>{t.estBudget}</span>
                <p className="font-mono-code font-bold text-base text-[#E32236] mt-0.5">
                  ${req.estimatedBudget.toLocaleString()}
                </p>
              </div>
              <div className={`p-3 rounded-lg border ${bgSubtle}`}>
                <span className={`text-[11px] uppercase ${textMuted}`}>{t.requesterLabel}</span>
                <p className="font-semibold text-xs mt-0.5">{isRtl ? req.requesterNameAr : req.requesterName}</p>
              </div>
              <div className={`p-3 rounded-lg border ${bgSubtle}`}>
                <span className={`text-[11px] uppercase ${textMuted}`}>{t.deliveryDateLabel}</span>
                <p className="font-mono-code font-semibold text-xs mt-0.5">{req.deliveryDate || '—'}</p>
              </div>
            </div>
            <div className={`p-3 rounded-lg border ${bgSubtle}`}>
              <span className={`text-[11px] uppercase ${textMuted}`}>{t.reasonLabel}</span>
              <p className="font-medium text-xs mt-0.5">{isRtl ? req.reasonAr : req.reason}</p>
            </div>
          </div>

          <div className={`lg:col-span-7 p-6 rounded-xl border space-y-4 ${bgSurface}`}>
            <div className="flex items-center justify-between border-b border-black/10 dark:border-white/10 pb-3">
              <h2 className="text-base font-bold">{t.supplierOffersSection} ({reqOffers.length})</h2>
            </div>

            {reqOffers.length === 0 ? (
              <div className={`p-10 rounded-lg border text-center text-sm ${bgSubtle} ${textMuted}`}>
                {t.noOffersYet}
              </div>
            ) : (
              <div className="space-y-3">
                {reqOffers.map((offer) => (
                  <div
                    key={offer.id}
                    className={`p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${bgSubtle}`}
                  >
                    <div>
                      <div className="flex items-center gap-2">
                        <span className="font-bold text-sm">{offer.supplierName}</span>
                        <span
                          className={`px-2 py-0.5 rounded text-[11px] font-bold ${
                            offer.reviewed
                              ? 'bg-emerald-500/15 text-emerald-500'
                              : 'bg-amber-500/15 text-amber-500'
                          }`}
                        >
                          {offer.reviewed ? t.offerStatus_Reviewed : t.offerStatus_NotReviewed}
                        </span>
                      </div>
                      <div className={`text-xs font-mono-code mt-1 flex items-center gap-1.5 ${textMuted}`}>
                        <FileText className="w-3.5 h-3.5 text-[#E32236]" />
                        {offer.fileName}
                      </div>
                    </div>

                    <div className="flex items-center gap-3">
                      <div className="text-end font-mono-code">
                        <div className="font-extrabold text-sm">${offer.totalPrice.toLocaleString()}</div>
                        <div className={`text-[11px] ${textMuted}`}>{offer.deliveryDays} {t.daysUnit}</div>
                      </div>
                      {(currentUser?.role === 'officer' || currentUser?.role === 'manager') && (
                        <button
                          onClick={() => {
                            setSelectedOfferId(offer.id);
                            setActiveScreen(10);
                          }}
                          className="px-3 py-1.5 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-semibold flex items-center gap-1.5"
                        >
                          <Sparkles className="w-3.5 h-3.5" />
                          {t.reviewWithAi}
                        </button>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

        <div className={`p-6 rounded-xl border ${bgSurface}`}>
          <h2 className="text-base font-bold mb-4">{t.comparisonTitle}</h2>
          <SupplierComparisonView requestId={req.id} standalone={false} />
        </div>

        <div className={`p-6 rounded-xl border ${bgSurface}`}>
          <h2 className="text-base font-bold mb-4">{t.recentAuditActivity}</h2>
          <div className="space-y-2.5">
            {reqAudit.map((entry) => (
              <div key={entry.id} className={`p-3 rounded-lg border flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs ${bgSubtle}`}>
                <div className="flex items-center gap-2.5">
                  <span className="font-mono-code text-[#E32236] font-bold">{entry.timestamp}</span>
                  <span className="font-bold">{isRtl ? entry.userAr : entry.user}</span>
                  <span className="px-2 py-0.5 rounded bg-black/5 dark:bg-white/5 font-semibold">
                    {isRtl ? entry.actionAr : entry.action}
                  </span>
                </div>
                <span className={textMuted}>{isRtl ? entry.detailsAr : entry.details}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 05: APPROVALS PAGE (MANAGER / APPROVER ONLY)
  // ==========================================================================
  const ApprovalsScreen = () => {
    const pendingReqs = requests.filter((r) => r.status === 'PendingApproval');
    const [confirmTarget, setConfirmTarget] = useState(null);
    const [rejectTarget, setRejectTarget] = useState(null);
    const [rejectReason, setRejectReason] = useState('');

    const executeApprove = (req) => {
      setRequests((prev) => prev.map((r) => (r.id === req.id ? { ...r, status: 'Approved' } : r)));
      addAuditEntry(
        'Approved Request',
        'اعتماد طلب الشراء',
        req.id,
        `Executive approval granted for ${req.id}`,
        `تمت الموافقة التنفيذية على الطلب ${req.id}`
      );
      setConfirmTarget(null);
      showToast(isRtl ? 'تم اعتماد طلب الشراء بنجاح' : `Request ${req.id} formally approved.`);
    };

    const executeReject = (req) => {
      if (!rejectReason.trim()) return;
      setRequests((prev) => prev.map((r) => (r.id === req.id ? { ...r, status: 'Rejected' } : r)));
      addAuditEntry(
        'Rejected Request',
        'رفض طلب الشراء',
        req.id,
        `Rejected ${req.id} — Reason: ${rejectReason}`,
        `تم رفض الطلب ${req.id} — السبب: ${rejectReason}`
      );
      setRejectTarget(null);
      setRejectReason('');
      showToast(isRtl ? 'تم رفض الطلب وتسجيل السبب' : `Request ${req.id} rejected.`);
    };

    return (
      <div className="space-y-6">
        <div className="pb-5 border-b border-black/10 dark:border-white/10">
          <div className="text-xs font-bold uppercase tracking-widest text-[#E32236] mb-1">
            05 // EXECUTIVE AUTHORIZATION QUEUE
          </div>
          <h1 className="text-3xl font-extrabold tracking-tight">{t.approvalsTitle}</h1>
          <p className={`text-sm mt-1 ${textMuted}`}>{t.approvalsSub}</p>
        </div>

        {pendingReqs.length === 0 ? (
          <div className={`p-16 rounded-xl border text-center ${bgSurface}`}>
            <CheckCircle2 className="w-10 h-10 text-emerald-500 mx-auto mb-3" />
            <p className="font-bold text-base">{t.noPendingApprovals}</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 gap-5">
            {pendingReqs.map((req) => {
              const reqOffers = offers.filter((o) => o.requestId === req.id);
              const bestOffer = reqOffers.length
                ? [...reqOffers].sort((a, b) => a.totalPrice - b.totalPrice)[0]
                : null;

              return (
                <div key={req.id} className={`p-6 rounded-xl border flex flex-col lg:flex-row lg:items-center justify-between gap-6 ${bgSurface}`}>
                  <div className="space-y-2 max-w-2xl">
                    <div className="flex items-center gap-3">
                      <span className="font-mono-code font-bold text-[#E32236]">{req.id}</span>
                      <StatusBadge status={req.status} lang={lang} />
                      <span className={`text-xs font-mono-code ${textMuted}`}>{t.submissionDate}: {req.createdDate}</span>
                    </div>
                    <h2 className="text-xl font-extrabold">{isRtl ? req.titleAr : req.title}</h2>
                    <p className={`text-xs ${textMuted}`}>{isRtl ? req.descriptionAr : req.description}</p>
                  </div>

                  <div className={`p-4 rounded-xl border grid grid-cols-2 sm:grid-cols-3 gap-4 shrink-0 ${bgSubtle}`}>
                    <div>
                      <span className={`text-[10px] uppercase font-bold ${textMuted}`}>{t.estBudget}</span>
                      <div className="font-mono-code font-bold text-sm mt-0.5">${req.estimatedBudget.toLocaleString()}</div>
                    </div>
                    <div>
                      <span className={`text-[10px] uppercase font-bold ${textMuted}`}>{t.recommendedOffer}</span>
                      <div className="font-bold text-xs mt-0.5 text-emerald-500">
                        {bestOffer ? bestOffer.supplierName : 'Prime Solutions'}
                      </div>
                    </div>
                    <div>
                      <span className={`text-[10px] uppercase font-bold ${textMuted}`}>{t.recommendedPrice}</span>
                      <div className="font-mono-code font-extrabold text-base text-[#E32236]">
                        ${(bestOffer ? bestOffer.totalPrice : 37400).toLocaleString()}
                      </div>
                    </div>
                  </div>

                  <div className="flex flex-wrap items-center gap-2.5 shrink-0">
                    <button
                      onClick={() => {
                        setSelectedRequestId(req.id);
                        setActiveScreen(4);
                      }}
                      className={`px-3.5 py-2.5 rounded-lg border text-xs font-bold ${bgSubtle} hover:border-[#E32236]`}
                    >
                      {t.viewDetails}
                    </button>
                    <button
                      onClick={() => setConfirmTarget(req)}
                      className="px-4 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center gap-1.5"
                    >
                      <Check className="w-4 h-4" />
                      {t.approve}
                    </button>
                    <button
                      onClick={() => setRejectTarget(req)}
                      className="px-4 py-2.5 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-bold flex items-center gap-1.5"
                    >
                      <X className="w-4 h-4" />
                      {t.reject}
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {confirmTarget && (
          <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
            <div className={`w-full max-w-md rounded-2xl border p-6 space-y-4 ${bgSurface}`}>
              <h3 className="text-lg font-extrabold">{t.confirmApprovalTitle}</h3>
              <p className={`text-sm ${textMuted}`}>{t.confirmApprovalMsg}</p>
              <div className={`p-3 rounded-lg border text-xs font-mono-code ${bgSubtle}`}>
                {confirmTarget.id} — {isRtl ? confirmTarget.titleAr : confirmTarget.title}
              </div>
              <div className="flex justify-end gap-2.5 pt-2">
                <button onClick={() => setConfirmTarget(null)} className={`px-4 py-2 rounded-lg border text-xs font-semibold ${bgSubtle}`}>
                  {t.cancel}
                </button>
                <button
                  onClick={() => executeApprove(confirmTarget)}
                  className="px-5 py-2 rounded-lg bg-emerald-600 text-white text-xs font-bold"
                >
                  {t.approve}
                </button>
              </div>
            </div>
          </div>
        )}

        {rejectTarget && (
          <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
            <div className={`w-full max-w-md rounded-2xl border p-6 space-y-4 ${bgSurface}`}>
              <h3 className="text-lg font-extrabold text-[#E32236]">{t.rejectModalTitle}</h3>
              <div>
                <label className="block text-xs font-bold mb-1.5">{t.rejectReasonLabel} *</label>
                <textarea
                  rows={3}
                  value={rejectReason}
                  onChange={(e) => setRejectReason(e.target.value)}
                  placeholder={t.rejectReasonPlaceholder}
                  className={`w-full px-3.5 py-2 rounded-lg border text-sm outline-none focus:border-[#E32236] ${bgSubtle}`}
                />
              </div>
              <div className="flex justify-end gap-2.5 pt-2">
                <button
                  onClick={() => {
                    setRejectTarget(null);
                    setRejectReason('');
                  }}
                  className={`px-4 py-2 rounded-lg border text-xs font-semibold ${bgSubtle}`}
                >
                  {t.cancel}
                </button>
                <button
                  onClick={() => executeReject(rejectTarget)}
                  disabled={!rejectReason.trim()}
                  className="px-5 py-2 rounded-lg bg-[#E32236] text-white text-xs font-bold disabled:opacity-50"
                >
                  {t.reject}
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 06: AUDIT LOG (READ-ONLY TRANSPARENCY LEDGER)
  // ==========================================================================
  const AuditLogScreen = () => {
    const [userFilter, setUserFilter] = useState('ALL');
    const [actionFilter, setActionFilter] = useState('ALL');
    const [reqFilter, setReqFilter] = useState('ALL');

    const uniqueUsers = useMemo(() => [...new Set(auditLog.map((a) => a.user))], [auditLog]);
    const uniqueActions = useMemo(() => [...new Set(auditLog.map((a) => a.action))], [auditLog]);
    const uniqueReqs = useMemo(() => [...new Set(auditLog.map((a) => a.requestId))], [auditLog]);

    const filteredLogs = useMemo(() => {
      return auditLog.filter((item) => {
        if (userFilter !== 'ALL' && item.user !== userFilter) return false;
        if (actionFilter !== 'ALL' && item.action !== actionFilter) return false;
        if (reqFilter !== 'ALL' && item.requestId !== reqFilter) return false;
        return true;
      });
    }, [auditLog, userFilter, actionFilter, reqFilter]);

    return (
      <div className="space-y-6">
        <div className="pb-5 border-b border-black/10 dark:border-white/10">
          <div className="text-xs font-bold uppercase tracking-widest text-[#E32236] mb-1">
            06 // IMMUTABLE GOVERNANCE LEDGER
          </div>
          <h1 className="text-3xl font-extrabold tracking-tight">{t.auditLogTitle}</h1>
          <p className={`text-sm mt-1 ${textMuted}`}>{t.auditLogSub}</p>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <select
            value={userFilter}
            onChange={(e) => setUserFilter(e.target.value)}
            className={`px-3.5 py-2.5 rounded-lg border text-xs font-semibold outline-none ${bgSurface}`}
          >
            <option value="ALL">{t.allUsers}</option>
            {uniqueUsers.map((u) => (
              <option key={u} value={u}>{u}</option>
            ))}
          </select>

          <select
            value={actionFilter}
            onChange={(e) => setActionFilter(e.target.value)}
            className={`px-3.5 py-2.5 rounded-lg border text-xs font-semibold outline-none ${bgSurface}`}
          >
            <option value="ALL">{t.allActions}</option>
            {uniqueActions.map((ac) => (
              <option key={ac} value={ac}>{ac}</option>
            ))}
          </select>

          <select
            value={reqFilter}
            onChange={(e) => setReqFilter(e.target.value)}
            className={`px-3.5 py-2.5 rounded-lg border text-xs font-semibold outline-none ${bgSurface}`}
          >
            <option value="ALL">{t.allRequestsFilter}</option>
            {uniqueReqs.map((rq) => (
              <option key={rq} value={rq}>{rq}</option>
            ))}
          </select>
        </div>

        <div className={`rounded-xl border overflow-hidden ${bgSurface}`}>
          <div className="overflow-x-auto">
            <table className="w-full text-start border-collapse">
              <thead>
                <tr className={`border-b text-[11px] font-bold uppercase tracking-wider ${bgSubtle} ${textMuted}`}>
                  <th className="py-3.5 px-5 text-start">{t.timestamp}</th>
                  <th className="py-3.5 px-5 text-start">{t.userCol}</th>
                  <th className="py-3.5 px-5 text-start">{t.actionCol}</th>
                  <th className="py-3.5 px-5 text-start">{t.reqId}</th>
                  <th className="py-3.5 px-5 text-start">{t.detailsCol}</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-black/5 dark:divide-white/5 text-xs">
                {filteredLogs.map((log) => (
                  <tr key={log.id} className="hover:bg-black/[0.02] dark:hover:bg-white/[0.02]">
                    <td className="py-3.5 px-5 font-mono-code text-[#E32236] font-semibold whitespace-nowrap">
                      {log.timestamp}
                    </td>
                    <td className="py-3.5 px-5 font-bold whitespace-nowrap">
                      {isRtl ? log.userAr : log.user}
                    </td>
                    <td className="py-3.5 px-5 whitespace-nowrap">
                      <span className={`px-2.5 py-1 rounded border font-semibold ${bgSubtle}`}>
                        {isRtl ? log.actionAr : log.action}
                      </span>
                    </td>
                    <td className="py-3.5 px-5 font-mono-code font-bold">{log.requestId}</td>
                    <td className={`py-3.5 px-5 ${textMuted}`}>{isRtl ? log.detailsAr : log.details}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 07: SUPPLIER REQUESTS (SUPPLIER ONLY — NO INTERNAL BUDGETS)
  // ==========================================================================
  const SupplierRequestsScreen = () => {
    const supplierId = currentUser?.supplierId || 'SUP-01';
    const invitedReqs = requests.filter((r) => r.invitedSupplierIds?.includes(supplierId));

    return (
      <div className="space-y-6">
        <div className="pb-5 border-b border-black/10 dark:border-white/10">
          <div className="text-xs font-bold uppercase tracking-widest text-[#E32236] mb-1">
            07 // VENDOR TENDER PORTAL — {isRtl ? 'شركة تك سبلاي المحدودة' : 'TECHSUPPLY LTD.'}
          </div>
          <h1 className="text-3xl font-extrabold tracking-tight">{t.supplierPortalTitle}</h1>
          <p className={`text-sm mt-1 ${textMuted}`}>{t.supplierPortalSub}</p>
        </div>

        {invitedReqs.length === 0 ? (
          <div className={`p-16 rounded-xl border text-center ${bgSurface}`}>
            <Building2 className={`w-10 h-10 mx-auto mb-3 ${textMuted}`} />
            <p className="font-bold text-base">{t.noSupplierRequests}</p>
          </div>
        ) : (
          <div className={`rounded-xl border overflow-hidden ${bgSurface}`}>
            <div className="overflow-x-auto">
              <table className="w-full text-start border-collapse">
                <thead>
                  <tr className={`border-b text-[11px] font-bold uppercase tracking-wider ${bgSubtle} ${textMuted}`}>
                    <th className="py-3.5 px-5 text-start">{t.reqTitle}</th>
                    <th className="py-3.5 px-5 text-start">{t.quantity}</th>
                    <th className="py-3.5 px-5 text-start">{t.deadlineCol}</th>
                    <th className="py-3.5 px-5 text-start">{t.myOfferStatus}</th>
                    <th className="py-3.5 px-5 text-end"></th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-black/5 dark:divide-white/5 text-sm">
                  {invitedReqs.map((req) => {
                    const hasSubmitted = offers.some(
                      (o) => o.requestId === req.id && o.supplierId === supplierId
                    );
                    return (
                      <tr
                        key={req.id}
                        onClick={() => {
                          setSelectedRequestId(req.id);
                          setActiveScreen(8);
                        }}
                        className="cursor-pointer transition hover:bg-[#E32236]/[0.04]"
                      >
                        <td className="py-4 px-5">
                          <span className="font-mono-code text-xs font-bold text-[#E32236] block mb-0.5">
                            {req.id}
                          </span>
                          <span className="font-bold">{isRtl ? req.titleAr : req.title}</span>
                        </td>
                        <td className="py-4 px-5 font-mono-code font-semibold">
                          {req.quantity} {t.units}
                        </td>
                        <td className="py-4 px-5 font-mono-code text-xs">{req.deliveryDate}</td>
                        <td className="py-4 px-5">
                          <span
                            className={`px-2.5 py-1 rounded text-xs font-bold border ${
                              hasSubmitted
                                ? 'bg-emerald-500/15 text-emerald-500 border-emerald-500/30'
                                : 'bg-amber-500/15 text-amber-500 border-amber-500/30'
                            }`}
                          >
                            {hasSubmitted ? t.offerSubmitted : t.offerNotSubmitted}
                          </span>
                        </td>
                        <td className="py-4 px-5 text-end">
                          <span className="text-xs font-bold text-[#E32236] inline-flex items-center gap-1">
                            {t.uploadQuotationBtn}
                            {isRtl ? <ChevronLeft className="w-4 h-4" /> : <ChevronRight className="w-4 h-4" />}
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 08: SUPPLIER REQUEST DETAILS & CLEAN PDF QUOTATION UPLOAD
  // ==========================================================================
  const SupplierUploadScreen = () => {
    const supplierId = currentUser?.supplierId || 'SUP-01';
    const invitedReqs = requests.filter((r) => r.invitedSupplierIds?.includes(supplierId));
    const req = invitedReqs.find((r) => r.id === selectedRequestId) || invitedReqs[0] || requests[2];
    const existingOffer = offers.find((o) => o.requestId === req.id && o.supplierId === supplierId);

    const [selectedFile, setSelectedFile] = useState(null);
    const [uploadState, setUploadState] = useState(existingOffer ? 'success' : 'idle');
    const [progress, setProgress] = useState(existingOffer ? 100 : 0);
    const [errorMsg, setErrorMsg] = useState('');
    const [forceFail, setForceFail] = useState(false);
    const fileInputRef = useRef(null);

    const handleFileChosen = (file) => {
      if (!file) return;
      setErrorMsg('');
      if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
        setUploadState('error');
        setErrorMsg(t.uploadErrorPdfOnly);
        return;
      }
      setSelectedFile(file);
      setUploadState('idle');
      setProgress(0);
    };

    const startUpload = () => {
      const fileNameToUse = selectedFile ? selectedFile.name : `TechSupply_Quote_${req.id}.pdf`;
      setUploadState('uploading');
      setProgress(15);
      setErrorMsg('');

      let p = 15;
      const timer = setInterval(() => {
        p += 25;
        setProgress(Math.min(p, 95));
        if (p >= 95) {
          clearInterval(timer);
          if (forceFail) {
            setUploadState('error');
            setErrorMsg(t.uploadErrorGeneric);
          } else {
            setProgress(100);
            setUploadState('success');
            const newOffer = {
              id: `OFF-${Math.floor(300 + Math.random() * 600)}`,
              requestId: req.id,
              supplierId,
              supplierName: 'TechSupply Ltd.',
              fileName: fileNameToUse,
              uploadedAt: new Date().toISOString().replace('T', ' ').substring(0, 16),
              extractionStatus: 'Completed',
              reviewed: false,
              totalPrice: 31500,
              currency: 'USD',
              deliveryDays: 10,
              paymentTerms: 'Net 30',
              warrantyMonths: 24,
              notes: 'Uploaded via PROCURA Supplier Portal.'
            };
            setOffers((prev) => {
              const filtered = prev.filter((o) => !(o.requestId === req.id && o.supplierId === supplierId));
              return [...filtered, newOffer];
            });
            setRequests((prev) =>
              prev.map((r) => (r.id === req.id && r.status === 'Submitted' ? { ...r, status: 'OffersReceived' } : r))
            );
            addAuditEntry(
              'Uploaded Quotation',
              'رفع عرض سعر',
              req.id,
              `TechSupply Ltd. uploaded ${fileNameToUse}`,
              `قامت شركة تك سبلاي برفع الملف ${fileNameToUse}`
            );
            showToast(t.uploadSuccessMsg);
          }
        }
      }, 220);
    };

    return (
      <div className="space-y-6">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-black/10 dark:border-white/10">
          <div>
            <button
              onClick={() => setActiveScreen(7)}
              className={`text-xs font-semibold flex items-center gap-1 mb-2 ${textMuted} hover:text-[#E32236]`}
            >
              {isRtl ? <ArrowRight className="w-3.5 h-3.5" /> : <ArrowLeft className="w-3.5 h-3.5" />}
              {t.navSupplierRequests}
            </button>
            <h1 className="text-2xl lg:text-3xl font-extrabold tracking-tight">{t.uploadQuotationTitle}</h1>
          </div>

          <label className={`flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs cursor-pointer ${bgSurface}`}>
            <input
              type="checkbox"
              checked={forceFail}
              onChange={(e) => setForceFail(e.target.checked)}
              className="accent-[#E32236]"
            />
            <span>{t.simulateUploadFail}</span>
          </label>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          {/* Left: Tender Specifications (STRICTLY NO INTERNAL BUDGET DISPLAYED) */}
          <div className={`lg:col-span-5 p-6 rounded-xl border space-y-4 ${bgSurface}`}>
            <div className="flex items-center justify-between">
              <span className="font-mono-code font-bold text-[#E32236]">{req.id}</span>
              <span className={`text-xs font-mono-code ${textMuted}`}>{t.deadlineCol}: {req.deliveryDate}</span>
            </div>
            <h2 className="text-xl font-extrabold">{isRtl ? req.titleAr : req.title}</h2>
            <p className={`text-sm leading-relaxed ${textMuted}`}>
              {isRtl ? req.descriptionAr : req.description}
            </p>
            <div className="grid grid-cols-2 gap-3 pt-2">
              <div className={`p-3 rounded-lg border ${bgSubtle}`}>
                <span className={`text-[11px] uppercase ${textMuted}`}>{t.quantity}</span>
                <p className="font-mono-code font-bold text-base mt-0.5">{req.quantity} {t.units}</p>
              </div>
              <div className={`p-3 rounded-lg border ${bgSubtle}`}>
                <span className={`text-[11px] uppercase ${textMuted}`}>{t.deliveryDateLabel}</span>
                <p className="font-mono-code font-bold text-sm mt-0.5">{req.deliveryDate}</p>
              </div>
            </div>
            <div className={`p-3 rounded-lg border text-xs flex items-center gap-2 ${bgSubtle} ${textMuted}`}>
              <Lock className="w-4 h-4 text-[#E32236] shrink-0" />
              <span>{t.budgetConfidentialNote}</span>
            </div>
          </div>

          {/* Right: Clean Drag-and-Drop PDF Uploader */}
          <div className={`lg:col-span-7 p-6 rounded-xl border space-y-5 ${bgSurface}`}>
            <div
              onDragOver={(e) => e.preventDefault()}
              onDrop={(e) => {
                e.preventDefault();
                if (e.dataTransfer.files?.[0]) handleFileChosen(e.dataTransfer.files[0]);
              }}
              className={`p-10 rounded-xl border-2 border-dashed text-center transition ${
                uploadState === 'error'
                  ? 'border-[#E32236] bg-[#E32236]/5'
                  : 'border-black/15 dark:border-white/15 hover:border-[#E32236]'
              }`}
            >
              <Upload className="w-10 h-10 text-[#E32236] mx-auto mb-3" />
              <p className="font-bold text-base">{t.uploadAreaTitle}</p>
              <p className={`text-xs mt-1 mb-5 ${textMuted}`}>{t.uploadAreaSub}</p>

              <input
                ref={fileInputRef}
                type="file"
                accept=".pdf,application/pdf"
                onChange={(e) => handleFileChosen(e.target.files?.[0])}
                className="hidden"
              />

              <div className="flex flex-wrap items-center justify-center gap-3">
                <button
                  type="button"
                  onClick={() => fileInputRef.current?.click()}
                  className={`px-4 py-2.5 rounded-lg border text-xs font-bold ${bgSurface} hover:border-[#E32236]`}
                >
                  {t.browseFiles}
                </button>
                <button
                  type="button"
                  onClick={startUpload}
                  disabled={uploadState === 'uploading'}
                  className="px-6 py-2.5 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-bold shadow-lg shadow-[#E32236]/20"
                >
                  {t.uploadQuotationBtn}
                </button>
              </div>
            </div>

            {uploadState === 'uploading' && (
              <div className="space-y-1.5">
                <div className="flex justify-between text-xs font-semibold">
                  <span>{t.uploadingText}</span>
                  <span className="font-mono-code">{progress}%</span>
                </div>
                <div className="w-full h-2 rounded-full bg-black/10 dark:bg-white/10 overflow-hidden">
                  <div className="h-full bg-[#E32236] transition-all" style={{ width: `${progress}%` }} />
                </div>
              </div>
            )}

            {uploadState === 'error' && (
              <div className="p-3.5 rounded-lg bg-[#E32236]/10 border border-[#E32236]/40 text-[#E32236] text-xs flex items-center justify-between gap-3">
                <div className="flex items-center gap-2 font-semibold">
                  <AlertTriangle className="w-4 h-4 shrink-0" />
                  <span>{errorMsg}</span>
                </div>
                <button
                  onClick={startUpload}
                  className="px-3 py-1 rounded bg-[#E32236] text-white font-bold shrink-0"
                >
                  {t.retry}
                </button>
              </div>
            )}

            {uploadState === 'success' && (
              <div className="p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 text-xs flex items-center justify-between">
                <div className="flex items-center gap-2 font-bold">
                  <CheckCircle2 className="w-4 h-4 shrink-0" />
                  <span>{t.uploadSuccessMsg}</span>
                </div>
                <span className="font-mono-code font-semibold">
                  {selectedFile?.name || existingOffer?.fileName || `TechSupply_Quote_${req.id}.pdf`}
                </span>
              </div>
            )}
          </div>
        </div>
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 09: SUPPLIER INVITATION MODAL (PROCUREMENT OFFICER)
  // ==========================================================================
  const SupplierInvitationModal = () => {
    if (!isInviteModalOpen) return null;
    const req = currentRequest;
    const [selectedIds, setSelectedIds] = useState(
      req.invitedSupplierIds?.length ? req.invitedSupplierIds : ['SUP-01', 'SUP-02', 'SUP-03']
    );
    const [error, setError] = useState('');

    const toggleSupplier = (id) => {
      setError('');
      setSelectedIds((prev) =>
        prev.includes(id) ? prev.filter((item) => item !== id) : [...prev, id]
      );
    };

    const handleSendInvitations = () => {
      if (selectedIds.length === 0) {
        setError(t.selectAtLeastOne);
        return;
      }
      setRequests((prev) =>
        prev.map((r) => (r.id === req.id ? { ...r, invitedSupplierIds: selectedIds } : r))
      );
      const names = REGISTERED_SUPPLIERS.filter((s) => selectedIds.includes(s.id))
        .map((s) => s.name)
        .join(', ');
      addAuditEntry(
        'Invited Suppliers',
        'دعوة موردين',
        req.id,
        `Invited ${selectedIds.length} suppliers: ${names}`,
        `تمت دعوة ${selectedIds.length} موردين لتقديم عروضهم`
      );
      setIsInviteModalOpen(false);
      showToast(
        isRtl
          ? `تم إرسال الدعوات إلى ${selectedIds.length} موردين بنجاح`
          : `Dispatched sourcing invitations to ${selectedIds.length} suppliers.`
      );
    };

    return (
      <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
        <div className={`w-full max-w-lg rounded-2xl border p-6 lg:p-7 shadow-2xl space-y-5 ${bgSurface}`}>
          <div className="flex items-start justify-between gap-4 border-b border-black/10 dark:border-white/10 pb-4">
            <div>
              <div className="text-[11px] font-bold uppercase tracking-widest text-[#E32236] mb-1">
                09 // VENDOR DISPATCH — {req.id}
              </div>
              <h3 className="text-xl font-extrabold">{t.inviteModalTitle}</h3>
              <p className={`text-xs mt-1 ${textMuted}`}>{t.inviteModalSub}</p>
            </div>
            <button onClick={() => setIsInviteModalOpen(false)} className={`p-1.5 rounded-lg ${bgSubtle}`}>
              <X className="w-4 h-4" />
            </button>
          </div>

          <div className="space-y-2.5">
            {REGISTERED_SUPPLIERS.map((sup) => {
              const checked = selectedIds.includes(sup.id);
              return (
                <label
                  key={sup.id}
                  onClick={() => toggleSupplier(sup.id)}
                  className={`p-4 rounded-xl border flex items-center justify-between cursor-pointer transition ${
                    checked ? 'border-[#E32236] bg-[#E32236]/[0.06]' : bgSubtle
                  }`}
                >
                  <div className="flex items-center gap-3">
                    <div
                      className={`w-5 h-5 rounded flex items-center justify-center border ${
                        checked ? 'bg-[#E32236] border-[#E32236] text-white' : 'border-slate-500'
                      }`}
                    >
                      {checked && <Check className="w-3.5 h-3.5" />}
                    </div>
                    <div>
                      <div className="font-bold text-sm">{isRtl ? sup.nameAr : sup.name}</div>
                      <div className={`text-xs ${textMuted}`}>{isRtl ? sup.categoryAr : sup.category}</div>
                    </div>
                  </div>
                  <span className="font-mono-code text-xs font-bold text-amber-500">★ {sup.rating}</span>
                </label>
              );
            })}
          </div>

          {error && (
            <div className="p-2.5 rounded-lg bg-[#E32236]/10 border border-[#E32236]/40 text-[#E32236] text-xs font-semibold">
              {error}
            </div>
          )}

          <div className="flex items-center justify-between pt-3 border-t border-black/10 dark:border-white/10">
            <div className="text-xs font-bold">
              {t.selectedCount}: <span className="text-[#E32236] font-mono-code text-sm">{selectedIds.length}</span>
            </div>
            <div className="flex items-center gap-2.5">
              <button
                type="button"
                onClick={() => setIsInviteModalOpen(false)}
                className={`px-4 py-2 rounded-lg border text-xs font-semibold ${bgSubtle}`}
              >
                {t.cancel}
              </button>
              <button
                type="button"
                onClick={handleSendInvitations}
                className="px-5 py-2 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-bold flex items-center gap-1.5 shadow-lg shadow-[#E32236]/20"
              >
                <Send className="w-3.5 h-3.5" />
                {t.sendInvitations}
              </button>
            </div>
          </div>
        </div>
      </div>
    );
  };

  // ==========================================================================
  // SCREEN 10: AI EXTRACTION REVIEW (INTERACTIVE 3D DOCUMENT INSPECTOR)
  // ==========================================================================
  const AiExtractionScreen = () => {
    const offer = offers.find((o) => o.id === selectedOfferId) || offers[3] || offers[0];
    const [aiStatus, setAiStatus] = useState(offer.extractionStatus || 'Completed');
    const [activeField, setActiveField] = useState(null);
    const [use3DInspector, setUse3DInspector] = useState(true);
    const [form, setForm] = useState({
      supplierName: offer.supplierName || '',
      totalPrice: offer.totalPrice ?? '',
      currency: offer.currency || 'USD',
      deliveryDays: offer.deliveryDays ?? '',
      paymentTerms: offer.paymentTerms || '',
      warrantyMonths: offer.warrantyMonths ?? '',
      notes: offer.notes || ''
    });

    useEffect(() => {
      setForm({
        supplierName: offer.supplierName || '',
        totalPrice: offer.totalPrice ?? '',
        currency: offer.currency || 'USD',
        deliveryDays: offer.deliveryDays ?? '',
        paymentTerms: offer.paymentTerms || '',
        warrantyMonths: offer.warrantyMonths ?? '',
        notes: offer.notes || ''
      });
      setAiStatus(offer.extractionStatus || 'Completed');
    }, [offer]);

    const handleRetryAi = () => {
      setAiStatus('Processing');
      setTimeout(() => {
        setAiStatus('Completed');
      }, 1100);
    };

    const handleSaveApprove = (e) => {
      e.preventDefault();
      setOffers((prev) =>
        prev.map((o) =>
          o.id === offer.id
            ? {
                ...o,
                supplierName: form.supplierName,
                totalPrice: Number(form.totalPrice) || 0,
                currency: form.currency,
                deliveryDays: Number(form.deliveryDays) || 0,
                paymentTerms: form.paymentTerms,
                warrantyMonths: Number(form.warrantyMonths) || 0,
                notes: form.notes,
                extractionStatus: 'Completed',
                reviewed: true
              }
            : o
        )
      );
      addAuditEntry(
        'Verified AI Extraction',
        'اعتماد استخراج البيانات',
        offer.requestId,
        `Verified offer ${offer.id} (${form.supplierName}): $${Number(form.totalPrice).toLocaleString()}, ${form.deliveryDays}d, Terms: ${form.paymentTerms || 'N/A'}`,
        `تم اعتماد بيانات العرض ${offer.id} (${form.supplierName})`
      );
      setSelectedRequestId(offer.requestId);
      setActiveScreen(4);
      showToast(isRtl ? 'تم حفظ واعتماد البيانات المستخرجة بنجاح' : 'AI extraction verified and saved to comparison matrix.');
    };

    const openSimulatedPdf = () => {
      const pdfWindow = window.open('', '_blank');
      if (pdfWindow) {
        pdfWindow.document.write(`
          <html><head><title>${offer.fileName}</title></head>
          <body style="font-family:sans-serif;padding:40px;background:#f4f5f7;color:#111;">
            <div style="max-width:720px;margin:auto;background:#fff;padding:40px;border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,0.1);">
              <h2 style="color:#E32236;margin-top:0;">PROCURA — SOURCE QUOTATION PDF PREVIEW</h2>
              <p><strong>Document:</strong> ${offer.fileName}</p>
              <p><strong>Vendor:</strong> ${offer.supplierName}</p>
              <p><strong>Reference Request:</strong> ${offer.requestId}</p>
              <hr/>
              <p><strong>Total Quoted Amount:</strong> $${offer.totalPrice} ${offer.currency}</p>
              <p><strong>Estimated Delivery:</strong> ${offer.deliveryDays} Calendar Days</p>
              <p><strong>Warranty Coverage:</strong> ${offer.warrantyMonths} Months</p>
              <p><strong>Commercial Notes:</strong> ${offer.notes}</p>
            </div>
          </body></html>
        `);
        pdfWindow.document.close();
      }
    };

    const hasMissing = !form.paymentTerms.trim() || !form.totalPrice || !form.deliveryDays;

    return (
      <div className="space-y-6">
        <div className="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-5 border-b border-black/10 dark:border-white/10">
          <div>
            <div className="text-xs font-bold uppercase tracking-widest text-[#E32236] mb-1">
              10 // DOCUMENT INTELLIGENCE & HUMAN VERIFICATION
            </div>
            <h1 className="text-3xl font-extrabold tracking-tight">{t.aiReviewTitle}</h1>
            <p className={`text-sm mt-1 ${textMuted}`}>{t.aiReviewSub}</p>
          </div>

          <div className="flex flex-wrap items-center gap-2.5">
            <div className={`flex items-center gap-1 p-1 rounded-lg border text-xs ${bgSurface}`}>
              <span className={`px-2 font-medium ${textMuted}`}>{t.simulateAiState}</span>
              {['Processing', 'Completed', 'Failed'].map((st) => (
                <button
                  key={st}
                  onClick={() => setAiStatus(st)}
                  className={`px-2.5 py-1 rounded font-semibold transition ${
                    aiStatus === st ? 'bg-[#E32236] text-white' : `${textMuted} hover:text-[#E32236]`
                  }`}
                >
                  {t[`status_${st}`]}
                </button>
              ))}
            </div>

            <button
              type="button"
              onClick={openSimulatedPdf}
              className={`px-4 py-2 rounded-lg border text-xs font-bold flex items-center gap-1.5 ${bgSurface} hover:border-[#E32236]`}
            >
              <ExternalLink className="w-3.5 h-3.5 text-[#E32236]" />
              {t.openQuotationPdf}
            </button>
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <div className={`lg:col-span-5 p-6 rounded-xl border flex flex-col justify-between ${bgSurface}`}>
            <div>
              <div className="flex items-center justify-between gap-2 mb-3">
                <span className="font-mono-code text-xs font-bold text-[#E32236] truncate">{offer.fileName}</span>
                <div className="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    onClick={() => setUse3DInspector(!use3DInspector)}
                    className={`px-2.5 py-1 rounded border text-[11px] font-bold flex items-center gap-1 ${bgSubtle} hover:border-[#E32236]`}
                  >
                    <Box className="w-3 h-3 text-[#E32236]" />
                    <span>{use3DInspector ? t.viewClassic : t.view3d}</span>
                  </button>
                  <span
                    className={`px-2.5 py-0.5 rounded text-xs font-bold ${
                      aiStatus === 'Completed'
                        ? 'bg-emerald-500/15 text-emerald-500'
                        : aiStatus === 'Processing'
                        ? 'bg-amber-500/15 text-amber-500'
                        : 'bg-[#E32236]/15 text-[#E32236]'
                    }`}
                  >
                    {t[`status_${aiStatus}`]}
                  </span>
                </div>
              </div>

              {use3DInspector ? (
                <div className={`rounded-xl border overflow-hidden ${bgSubtle}`}>
                  <AiExtractionThreeScene
                    theme={theme}
                    extractionStatus={aiStatus}
                    hasMissingField={hasMissing}
                    activeField={activeField}
                  />
                  <div className={`px-3.5 py-2 border-t border-black/5 dark:border-white/5 text-[11px] ${textMuted}`}>
                    {t.hoverFieldHint}
                  </div>
                </div>
              ) : (
                <div className={`p-5 rounded-xl border space-y-2.5 text-xs font-mono-code ${bgSubtle}`}>
                  <div className="font-bold text-[#E32236]">QUOTATION EXTRACT SNAPSHOT</div>
                  <div>VENDOR: {form.supplierName || '—'}</div>
                  <div>AMOUNT: ${form.totalPrice || '0'} {form.currency}</div>
                  <div>DELIVERY: {form.deliveryDays || '0'} DAYS</div>
                  <div>WARRANTY: {form.warrantyMonths || '0'} MONTHS</div>
                  <div>TERMS: {form.paymentTerms || '[MISSING]'}</div>
                </div>
              )}
            </div>

            <div className="mt-4 pt-4 border-t border-black/10 dark:border-white/10">
              <div className={`text-[11px] font-bold uppercase mb-2 ${textMuted}`}>
                {isRtl ? 'تبديل عرض السعر للمراجعة:' : 'INSPECT QUOTATION RECORD:'}
              </div>
              <div className="flex flex-wrap gap-2">
                {offers.slice(0, 5).map((o) => (
                  <button
                    key={o.id}
                    onClick={() => setSelectedOfferId(o.id)}
                    className={`px-2.5 py-1 rounded border text-xs font-mono-code font-semibold ${
                      o.id === offer.id ? 'border-[#E32236] bg-[#E32236]/10 text-[#E32236]' : bgSubtle
                    }`}
                  >
                    {o.id} ({o.supplierName.split(' ')[0]})
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div className={`lg:col-span-7 p-6 lg:p-8 rounded-xl border ${bgSurface}`}>
            {aiStatus === 'Processing' ? (
              <div className="py-20 text-center space-y-3">
                <RefreshCw className="w-10 h-10 text-[#E32236] animate-spin mx-auto" />
                <h3 className="font-bold text-base">
                  {isRtl ? 'جارٍ تحليل بنود عرض السعر بالذكاء الاصطناعي...' : 'Neural OCR & Table Parser Extracting Quotation Fields...'}
                </h3>
                <p className={`text-xs ${textMuted}`}>
                  {isRtl ? 'يتم استخراج الأسعار وشروط الدفع والضمان تلقائياً' : 'Mapping commercial line items, currency, and warranty clauses'}
                </p>
              </div>
            ) : aiStatus === 'Failed' ? (
              <div className="py-16 text-center space-y-4">
                <AlertTriangle className="w-10 h-10 text-[#E32236] mx-auto" />
                <h3 className="font-bold text-base text-[#E32236]">
                  {isRtl ? 'فشل استخراج البيانات من المستند' : 'Automated Document Extraction Interrupted'}
                </h3>
                <p className={`text-xs max-w-md mx-auto ${textMuted}`}>
                  {isRtl
                    ? 'تعذر قراءة بعض الجداول في ملف PDF. يمكنك إعادة تشغيل الاستخراج الذكي.'
                    : 'The parser encountered an unreadable layer in the PDF stream. Re-run extraction engine to recover.'}
                </p>
                <button
                  type="button"
                  onClick={handleRetryAi}
                  className="px-5 py-2.5 rounded-lg bg-[#E32236] text-white text-xs font-bold inline-flex items-center gap-2"
                >
                  <RotateCcw className="w-4 h-4" />
                  {t.retryExtraction}
                </button>
              </div>
            ) : (
              <form onSubmit={handleSaveApprove} className="space-y-4">
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div
                    onMouseEnter={() => setActiveField('supplierName')}
                    onFocus={() => setActiveField('supplierName')}
                  >
                    <label className="block text-xs font-bold uppercase mb-1.5">{t.supplierName}</label>
                    <input
                      type="text"
                      value={form.supplierName}
                      onChange={(e) => setForm({ ...form, supplierName: e.target.value })}
                      className={`w-full px-3.5 py-2.5 rounded-lg border text-sm outline-none focus:border-[#E32236] ${bgSubtle}`}
                    />
                  </div>

                  <div
                    onMouseEnter={() => setActiveField('totalPrice')}
                    onFocus={() => setActiveField('totalPrice')}
                    className="grid grid-cols-3 gap-2"
                  >
                    <div className="col-span-2">
                      <label className="block text-xs font-bold uppercase mb-1.5">{t.totalPrice}</label>
                      <input
                        type="number"
                        value={form.totalPrice}
                        onChange={(e) => setForm({ ...form, totalPrice: e.target.value })}
                        className={`w-full px-3.5 py-2.5 rounded-lg border text-sm font-mono-code outline-none ${
                          !form.totalPrice ? 'border-amber-500 bg-amber-500/10' : bgSubtle
                        }`}
                      />
                    </div>
                    <div>
                      <label className="block text-xs font-bold uppercase mb-1.5">{t.currency}</label>
                      <input
                        type="text"
                        value={form.currency}
                        onChange={(e) => setForm({ ...form, currency: e.target.value })}
                        className={`w-full px-3.5 py-2.5 rounded-lg border text-sm font-mono-code outline-none ${bgSubtle}`}
                      />
                    </div>
                  </div>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div
                    onMouseEnter={() => setActiveField('deliveryDays')}
                    onFocus={() => setActiveField('deliveryDays')}
                  >
                    <label className="block text-xs font-bold uppercase mb-1.5">{t.deliveryDuration}</label>
                    <input
                      type="number"
                      value={form.deliveryDays}
                      onChange={(e) => setForm({ ...form, deliveryDays: e.target.value })}
                      className={`w-full px-3.5 py-2.5 rounded-lg border text-sm font-mono-code outline-none ${
                        !form.deliveryDays ? 'border-amber-500 bg-amber-500/10' : bgSubtle
                      }`}
                    />
                  </div>

                  <div
                    onMouseEnter={() => setActiveField('warrantyMonths')}
                    onFocus={() => setActiveField('warrantyMonths')}
                  >
                    <label className="block text-xs font-bold uppercase mb-1.5">{t.warrantyDuration}</label>
                    <input
                      type="number"
                      value={form.warrantyMonths}
                      onChange={(e) => setForm({ ...form, warrantyMonths: e.target.value })}
                      className={`w-full px-3.5 py-2.5 rounded-lg border text-sm font-mono-code outline-none ${bgSubtle}`}
                    />
                  </div>
                </div>

                <div
                  onMouseEnter={() => setActiveField('paymentTerms')}
                  onFocus={() => setActiveField('paymentTerms')}
                >
                  <div className="flex items-center justify-between mb-1.5">
                    <label className="text-xs font-bold uppercase">{t.paymentTerms}</label>
                    {!form.paymentTerms.trim() && (
                      <span className="text-[11px] font-bold text-amber-500 flex items-center gap-1">
                        <AlertTriangle className="w-3.5 h-3.5" />
                        {t.missingFieldWarn}
                      </span>
                    )}
                  </div>
                  <input
                    type="text"
                    value={form.paymentTerms}
                    onChange={(e) => setForm({ ...form, paymentTerms: e.target.value })}
                    placeholder="e.g., Net 30"
                    className={`w-full px-3.5 py-2.5 rounded-lg border text-sm outline-none transition ${
                      !form.paymentTerms.trim()
                        ? 'border-amber-500 bg-amber-500/10 ring-2 ring-amber-500/20'
                        : `${bgSubtle} focus:border-[#E32236]`
                    }`}
                  />
                </div>

                <div>
                  <label className="block text-xs font-bold uppercase mb-1.5">{t.notes}</label>
                  <textarea
                    rows={3}
                    value={form.notes}
                    onChange={(e) => setForm({ ...form, notes: e.target.value })}
                    className={`w-full px-3.5 py-2.5 rounded-lg border text-sm outline-none focus:border-[#E32236] ${bgSubtle}`}
                  />
                </div>

                <div className="pt-4 border-t border-black/10 dark:border-white/10 flex justify-end gap-3">
                  <button
                    type="button"
                    onClick={() => setActiveScreen(4)}
                    className={`px-4 py-2.5 rounded-lg border text-xs font-semibold ${bgSubtle}`}
                  >
                    {t.cancel}
                  </button>
                  <button
                    type="submit"
                    className="px-6 py-2.5 rounded-lg bg-[#E32236] hover:bg-[#C81B2D] text-white text-xs font-bold flex items-center gap-2 shadow-lg shadow-[#E32236]/25"
                  >
                    <CheckCircle2 className="w-4 h-4" />
                    {t.saveAndApprove}
                  </button>
                </div>
              </form>
            )}
          </div>
        </div>
      </div>
    );
  };

  // ==========================================================================
  // TOP STUDIO & 44-CONFIGURATION PRESENTATION BAR
  // ==========================================================================
  const StudioPresentationBar = () => {
    const screenList = [
      { num: 1, label: '01 Login' },
      { num: 2, label: '02 Requests' },
      { num: 3, label: '03 Create' },
      { num: 4, label: '04 Details (3D)' },
      { num: 5, label: '05 Approvals' },
      { num: 6, label: '06 Audit Log' },
      { num: 7, label: '07 Supplier Reqs' },
      { num: 8, label: '08 Upload PDF' },
      { num: 9, label: '09 Invite Modal' },
      { num: 10, label: '10 AI Review (3D)' },
      { num: 11, label: '11 Comparison (3D)' }
    ];

    if (presentationMode) {
      return (
        <button
          onClick={() => setPresentationMode(false)}
          className="fixed bottom-4 right-4 z-50 px-3 py-1.5 rounded-full bg-[#E32236] text-white text-xs font-bold shadow-lg opacity-80 hover:opacity-100 flex items-center gap-1.5"
        >
          <Minimize2 className="w-3.5 h-3.5" />
          {t.exitPresentation}
        </button>
      );
    }

    return (
      <div className="sticky top-0 z-40 bg-[#090B10] text-[#F2F3F5] border-b border-white/10 px-4 py-2 text-xs">
        <div className="max-w-[1440px] mx-auto flex flex-wrap items-center justify-between gap-2">
          <div className="flex items-center gap-2 overflow-x-auto">
            <span className="px-2 py-0.5 rounded bg-[#E32236] text-white font-extrabold tracking-wider text-[10px]">
              44-CONFIG STUDIO
            </span>
            <select
              value={activeScreen}
              onChange={(e) => jumpToScreen(Number(e.target.value))}
              className="bg-[#191C24] border border-white/15 rounded px-2.5 py-1 text-xs font-semibold outline-none focus:border-[#E32236]"
            >
              {screenList.map((s) => (
                <option key={s.num} value={s.num}>{s.label}</option>
              ))}
            </select>

            <select
              value={currentUser?.role || 'requester'}
              onChange={(e) => loginAsRole(e.target.value)}
              className="bg-[#191C24] border border-white/15 rounded px-2.5 py-1 text-xs font-semibold outline-none focus:border-[#E32236]"
            >
              <option value="requester">Role: Requester (Belal)</option>
              <option value="officer">Role: Officer (Mona)</option>
              <option value="manager">Role: Manager (Youssef)</option>
              <option value="supplier">Role: Supplier (TechSupply)</option>
            </select>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={() => setTheme(isDark ? 'light' : 'dark')}
              className="px-2.5 py-1 rounded bg-[#191C24] border border-white/15 hover:border-[#E32236] flex items-center gap-1.5 font-semibold"
            >
              {isDark ? <Sun className="w-3.5 h-3.5 text-amber-400" /> : <Moon className="w-3.5 h-3.5 text-sky-400" />}
              <span>{isDark ? 'Dark' : 'Light'}</span>
            </button>

            <button
              onClick={() => setLang(lang === 'en' ? 'ar' : 'en')}
              className="px-2.5 py-1 rounded bg-[#191C24] border border-white/15 hover:border-[#E32236] flex items-center gap-1.5 font-semibold"
            >
              <Globe className="w-3.5 h-3.5 text-[#E32236]" />
              <span>{lang === 'en' ? 'EN -> العربية' : 'العربية -> EN'}</span>
            </button>

            <button
              onClick={handleResetDemo}
              className="px-2.5 py-1 rounded bg-[#191C24] border border-white/15 hover:border-[#E32236] flex items-center gap-1 text-slate-300"
              title={t.resetDemo}
            >
              <RotateCcw className="w-3.5 h-3.5" />
              <span className="hidden sm:inline">{t.resetDemo}</span>
            </button>

            <button
              onClick={() => setPresentationMode(true)}
              className="px-2.5 py-1 rounded bg-[#E32236] hover:bg-[#C81B2D] text-white font-bold flex items-center gap-1"
            >
              <Maximize2 className="w-3.5 h-3.5" />
              <span className="hidden md:inline">{t.presentationMode}</span>
            </button>
          </div>
        </div>
      </div>
    );
  };

  // ==========================================================================
  // ENTERPRISE APPLICATION SHELL (SCREENS 02–11)
  // ==========================================================================
  const renderAppShell = () => {
    const role = currentUser?.role || 'requester';

    const navItems = [
      ...(role !== 'supplier'
        ? [{ id: 2, label: t.navRequests, icon: FileText }]
        : []),
      ...(role === 'requester'
        ? [{ id: 3, label: t.navCreateRequest, icon: Plus }]
        : []),
      ...(role === 'manager'
        ? [{ id: 5, label: t.navApprovals, icon: CheckCircle2 }]
        : []),
      ...(role === 'officer' || role === 'manager'
        ? [
            { id: 10, label: t.navAiReview, icon: Sparkles },
            { id: 11, label: t.navComparison, icon: Layers },
            { id: 6, label: t.navAuditLog, icon: History }
          ]
        : []),
      ...(role === 'supplier'
        ? [{ id: 7, label: t.navSupplierRequests, icon: Building2 }]
        : [])
    ];

    return (
      <div className={`min-h-[calc(100vh-44px)] flex flex-col lg:flex-row ${bgMain}`}>
        <aside className={`w-full lg:w-64 shrink-0 border-b lg:border-b-0 lg:border-e flex flex-col justify-between p-5 ${bgSurface}`}>
          <div className="space-y-6">
            <div className="flex items-center justify-between">
              <div onClick={() => setActiveScreen(role === 'supplier' ? 7 : 2)} className="cursor-pointer">
                <ProcuraLogo theme={theme} size="md" />
              </div>
            </div>

            <nav className="flex lg:flex-col gap-1.5 overflow-x-auto pb-1 lg:pb-0">
              {navItems.map((item) => {
                const Icon = item.icon;
                const active = activeScreen === item.id;
                return (
                  <button
                    key={item.id}
                    onClick={() => setActiveScreen(item.id)}
                    className={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-bold whitespace-nowrap transition ${
                      active
                        ? 'bg-[#E32236] text-white shadow-md shadow-[#E32236]/20'
                        : `${textMuted} hover:bg-black/5 dark:hover:bg-white/5`
                    }`}
                  >
                    <Icon className="w-4 h-4 shrink-0" />
                    <span>{item.label}</span>
                  </button>
                );
              })}
            </nav>
          </div>

          <div className="hidden lg:block space-y-3 pt-6 border-t border-black/10 dark:border-white/10">
            <div className="flex items-center gap-2">
              <button
                onClick={() => setTheme(isDark ? 'light' : 'dark')}
                className={`flex-1 py-2 px-3 rounded-lg border text-xs font-semibold flex items-center justify-center gap-1.5 ${bgSubtle} hover:border-[#E32236]`}
              >
                {isDark ? <Sun className="w-3.5 h-3.5 text-amber-400" /> : <Moon className="w-3.5 h-3.5" />}
                {isDark ? 'Light' : 'Dark'}
              </button>
              <button
                onClick={() => setLang(lang === 'en' ? 'ar' : 'en')}
                className={`flex-1 py-2 px-3 rounded-lg border text-xs font-semibold flex items-center justify-center gap-1.5 ${bgSubtle} hover:border-[#E32236]`}
              >
                <Globe className="w-3.5 h-3.5 text-[#E32236]" />
                {lang === 'en' ? 'العربية' : 'English'}
              </button>
            </div>

            <div className={`p-3 rounded-xl border ${bgSubtle}`}>
              <div className="text-xs font-extrabold truncate">
                {isRtl ? (currentUser?.companyNameAr || currentUser?.nameAr) : (currentUser?.companyName || currentUser?.name)}
              </div>
              <div className="text-[11px] text-[#E32236] font-semibold mt-0.5">
                {t[`role_${role}`]}
              </div>
            </div>

            <button
              onClick={() => {
                setCurrentUser(null);
                setActiveScreen(1);
              }}
              className={`w-full py-2 px-3 rounded-lg border text-xs font-semibold flex items-center justify-center gap-2 ${bgSubtle} hover:border-[#E32236] hover:text-[#E32236]`}
            >
              <LogOut className="w-3.5 h-3.5" />
              {t.logOut}
            </button>
          </div>
        </aside>

        <main className="flex-1 p-5 sm:p-8 lg:p-10 max-w-[1440px] mx-auto w-full">
          {activeScreen === 2 && <RequestsListScreen />}
          {activeScreen === 3 && <CreateRequestScreen />}
          {activeScreen === 4 && <RequestDetailsScreen />}
          {activeScreen === 5 && <ApprovalsScreen />}
          {activeScreen === 6 && <AuditLogScreen />}
          {activeScreen === 7 && <SupplierRequestsScreen />}
          {activeScreen === 8 && <SupplierUploadScreen />}
          {activeScreen === 10 && <AiExtractionScreen />}
          {activeScreen === 11 && <SupplierComparisonView requestId={currentRequest.id} standalone={true} />}
        </main>
      </div>
    );
  };

  return (
    <div className={`${lang === 'ar' ? 'font-ar' : 'font-en'} min-h-screen antialiased selection:bg-[#E32236] selection:text-white`}>
      <FontAndStyleInjector />
      <StudioPresentationBar />

      {activeScreen === 1 || !currentUser ? <LoginScreen /> : renderAppShell()}

      <SupplierInvitationModal />

      {toast && (
        <div
          className={`fixed bottom-5 ${isRtl ? 'left-5' : 'right-5'} z-50 px-4 py-3 rounded-xl shadow-2xl border text-xs font-bold flex items-center gap-2.5 ${
            toast.type === 'error'
              ? 'bg-[#E32236] text-white border-[#E32236]'
              : 'bg-[#191C24] text-white border-emerald-500/50'
          }`}
        >
          <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
          <span>{toast.msg}</span>
        </div>
      )}
    </div>
  );
}